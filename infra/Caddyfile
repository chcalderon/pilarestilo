# Pilar Estilo - Caddy reverse proxy configuration
#
# LOCAL DEV (no TLS):
#   Replace {$DOMAIN:localhost} with `:80` to bind on port 80 without TLS:
#
#     :80 {
#         handle /api/* { reverse_proxy backend:8080 }
#         handle        { reverse_proxy frontend:4321 }
#     }
#
# VPS WITH CUSTOM DOMAIN (automatic TLS):
#   Set DOMAIN=pilarestilo.com in infra/.env (or export it before running
#   docker compose). Caddy will contact Let's Encrypt automatically and
#   provision/renew the TLS certificate - no manual certbot needed.
#   Ports 80 and 443 must be reachable from the internet.
#
# NOTE: If the frontend Dockerfile serves via nginx on port 80, change
#       `frontend:4321` to `frontend:80` in the reverse_proxy directive below.

{$DOMAIN:localhost} {
    # Gateway policy: cap API payload size.
    @api_paths {
        path /api/*
    }
    request_body @api_paths {
        max_size 12MB
    }

    # Gateway policy: block unsupported HTTP methods for API traffic.
    @api_invalid_method {
        path /api/*
        not method GET HEAD POST PUT PATCH DELETE OPTIONS
    }
    respond @api_invalid_method "Method Not Allowed" 405

    route {
        # Notifications - the whole resource is owned by notification-service: the bell reads
        # (GET) and the mark-as-read writes (PUT). backend:8080 as fallback when the microservices
        # profile is off. (product/inventory/order/payment-service were consolidated back into the
        # monolith on 2026-08-30 — their routes now fall through to the generic /api/* handler.)
        @notification_reads {
            method GET HEAD PUT
            path /api/notifications /api/notifications/*
        }
        handle @notification_reads {
            reverse_proxy notification-service:8085 backend:8080 {
                lb_policy first
                lb_try_duration 5s
                fail_duration 15s
                transport http {
                    dial_timeout 2s
                    response_header_timeout 30s
                }
            }
        }

        # Product AI single-image inference/transform can take longer on cold model/API calls.
        @product_ai_infer_single {
            method POST
            path /api/admin/product-ai/infer-single
        }
        handle @product_ai_infer_single {
            reverse_proxy backend:8080 {
                lb_try_duration 5s
                fail_duration 15s
                transport http {
                    dial_timeout 5s
                    response_header_timeout 300s
                }
            }
        }

        @product_ai_transform_single {
            method POST
            path /api/admin/product-ai/transform-single
        }
        handle @product_ai_transform_single {
            reverse_proxy backend:8080 {
                lb_try_duration 5s
                fail_duration 15s
                transport http {
                    dial_timeout 5s
                    response_header_timeout 180s
                }
            }
        }

        # Bulk media optimization / migration endpoints can scan + rewrite
        # many files on disk and update DB rows. Allow up to 10 minutes.
        @media_admin_long {
            method POST
            path /api/admin/media/optimize-all
            path /api/admin/media/optimize-products
            path /api/admin/media/optimize-categories
            path /api/admin/media/optimize-existing
            path /api/admin/media/migrate-category-images
        }
        handle @media_admin_long {
            reverse_proxy backend:8080 {
                lb_try_duration 5s
                fail_duration 15s
                transport http {
                    dial_timeout 5s
                    response_header_timeout 600s
                }
            }
        }

        # API - proxy all remaining /api/* requests to the Spring Boot backend
        handle /api/* {
            reverse_proxy {
                dynamic a backend 8080
                lb_policy round_robin
                lb_try_duration 2s
                transport http {
                    dial_timeout 5s
                    response_header_timeout 30s
                }
            }
        }

        # Frontend - everything else goes to the Astro frontend
        handle {
            reverse_proxy frontend:4321
        }
    }

    # Compression
    encode gzip

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Access log
    log {
        output stdout
        format console
    }
}
