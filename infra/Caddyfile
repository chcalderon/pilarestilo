# Pilar Estilo - Caddy reverse proxy configuration
#
# LOCAL DEV (no TLS):
#   Replace {$DOMAIN:localhost} with `:80` to bind on port 80 without TLS:
#
#     :80 {
#         handle /api/* { reverse_proxy backend:8080 }
#         handle        { reverse_proxy frontend:4321 }
#     }
#
# VPS WITH CUSTOM DOMAIN (automatic TLS):
#   Set DOMAIN=pilarestilo.com in infra/.env (or export it before running
#   docker compose). Caddy will contact Let's Encrypt automatically and
#   provision/renew the TLS certificate - no manual certbot needed.
#   Ports 80 and 443 must be reachable from the internet.
#
# NOTE: If the frontend Dockerfile serves via nginx on port 80, change
#       `frontend:4321` to `frontend:80` in the reverse_proxy directive below.

{$DOMAIN:localhost} {
    # Gateway policy: cap API payload size.
    @api_paths {
        path /api/*
    }
    request_body @api_paths {
        max_size 12MB
    }

    # Gateway policy: block unsupported HTTP methods for API traffic.
    @api_invalid_method {
        path /api/*
        not method GET HEAD POST PUT PATCH DELETE OPTIONS
    }
    respond @api_invalid_method "Method Not Allowed" 405

    route {
        # Catalog reads - route product GETs to extracted product-service when active,
        # with backend:8080 as fallback when running without the microservices profile.
        @product_reads {
            method GET HEAD
            path /api/products /api/products/*
        }
        handle @product_reads {
            reverse_proxy product-service:8081 backend:8080 {
                lb_policy first
                lb_try_duration 5s
                fail_duration 15s
                transport http {
                    dial_timeout 2s
                    response_header_timeout 30s
                }
            }
        }

        # Inventory reads - route to extracted inventory-service with backend fallback.
        @inventory_reads {
            method GET HEAD
            path /api/inventory /api/inventory/*
        }
        handle @inventory_reads {
            reverse_proxy inventory-service:8082 backend:8080 {
                lb_policy first
                lb_try_duration 5s
                fail_duration 15s
                transport http {
                    dial_timeout 2s
                    response_header_timeout 30s
                }
            }
        }

        # Payment reads - route GET/HEAD payment queries to extracted payment-service with fallback.
        @payment_reads {
            method GET HEAD
            path /api/payments /api/payments/*
        }
        handle @payment_reads {
            reverse_proxy payment-service:8084 backend:8080 {
                lb_policy first
                lb_try_duration 5s
                fail_duration 15s
                transport http {
                    dial_timeout 2s
                    response_header_timeout 30s
                }
            }
        }

        # Order reads - route catalog/order queries to extracted order-service with backend fallback.
        @order_reads {
            method GET HEAD
            path /api/orders /api/orders/*
        }
        handle @order_reads {
            reverse_proxy order-service:8083 backend:8080 {
                lb_policy first
                lb_try_duration 5s
                fail_duration 15s
                transport http {
                    dial_timeout 2s
                    response_header_timeout 30s
                }
            }
        }

        # Order writes - keep backend as the auth/orchestration entrypoint.
        # Backend delegates to order-service via internal service token when remote-write is enabled.
        @order_writes {
            method POST PATCH
            path /api/orders /api/orders/*
        }
        handle @order_writes {
            reverse_proxy backend:8080 {
                lb_try_duration 5s
                fail_duration 15s
                transport http {
                    dial_timeout 2s
                    response_header_timeout 30s
                }
            }
        }

        @order_disallowed {
            path /api/orders /api/orders/*
        }
        handle @order_disallowed {
            respond "Method Not Allowed" 405
        }

        # Product AI single-image inference/transform can take longer on cold model/API calls.
        @product_ai_infer_single {
            method POST
            path /api/admin/product-ai/infer-single
        }
        handle @product_ai_infer_single {
            reverse_proxy backend:8080 {
                lb_try_duration 5s
                fail_duration 15s
                transport http {
                    dial_timeout 5s
                    response_header_timeout 300s
                }
            }
        }

        @product_ai_transform_single {
            method POST
            path /api/admin/product-ai/transform-single
        }
        handle @product_ai_transform_single {
            reverse_proxy backend:8080 {
                lb_try_duration 5s
                fail_duration 15s
                transport http {
                    dial_timeout 5s
                    response_header_timeout 180s
                }
            }
        }

        # Bulk media optimization / migration endpoints can scan + rewrite
        # many files on disk and update DB rows. Allow up to 10 minutes.
        @media_admin_long {
            method POST
            path /api/admin/media/optimize-all
            path /api/admin/media/optimize-products
            path /api/admin/media/optimize-categories
            path /api/admin/media/optimize-existing
            path /api/admin/media/migrate-category-images
        }
        handle @media_admin_long {
            reverse_proxy backend:8080 {
                lb_try_duration 5s
                fail_duration 15s
                transport http {
                    dial_timeout 5s
                    response_header_timeout 600s
                }
            }
        }

        # API - proxy all remaining /api/* requests to the Spring Boot backend
        handle /api/* {
            reverse_proxy {
                dynamic a backend 8080
                lb_policy round_robin
                lb_try_duration 2s
                transport http {
                    dial_timeout 5s
                    response_header_timeout 30s
                }
            }
        }

        # Frontend - everything else goes to the Astro frontend
        handle {
            reverse_proxy frontend:4321
        }
    }

    # Compression
    encode gzip

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Access log
    log {
        output stdout
        format console
    }
}
