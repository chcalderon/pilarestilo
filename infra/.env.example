# Copy this file to .env and fill in values
# Never commit .env to version control

# PostgreSQL
POSTGRES_DB=pilarestilo
POSTGRES_USER=pilar
POSTGRES_PASSWORD=change_me_strong_password

# Spring Backend (auto-composed from above in docker-compose.yml)
# SPRING_DATASOURCE_URL is set automatically to jdbc:postgresql://postgres:5432/${POSTGRES_DB}
# Override only if needed:
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/pilarestilo

# Caddy / Domain
# For local dev: leave as localhost (Caddy uses self-signed cert, access via http://localhost)
# For VPS: set to your domain(s) — Caddy auto-provisions TLS via Let's Encrypt.
# Include www if you want both served: DOMAIN=pilarestilo.com www.pilarestilo.com
# DNS A record must point to the VPS IP before first deploy or TLS provisioning fails.
DOMAIN=localhost

# JWT Authentication
# SECURITY: Generate a strong random secret for production.
# Minimum 32 bytes (256 bits) for HS256.
# Generate with: openssl rand -base64 32
JWT_SECRET=changeme-generate-a-strong-32-byte-secret-here
SYSTEM_SETTINGS_CRYPTO_SECRET=changeme-system-settings-crypto-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Frontend public env
PUBLIC_API_BASE_URL=/api
INTERNAL_API_BASE_URL=http://backend:8080/api
PUBLIC_WHATSAPP_PHONE=+56900000000
PUBLIC_WHATSAPP_MESSAGE_ES=Hola Pilar Estilo, quiero ayuda con una compra.
PUBLIC_WHATSAPP_MESSAGE_EN=Hi Pilar Estilo, I need help with a purchase.

# Notification provider (backend)
# Options: LOG | WHATSAPP_SIMULATED | WHATSAPP_TWILIO | EMAIL_SENDGRID | EMAIL_SMTP
# This value acts as default/fallback. Admin can override from /admin/settings.
NOTIFICATION_PROVIDER=EMAIL_SMTP
NOTIFICATION_N8N_WEBHOOK_URL=
NOTIFICATION_N8N_API_KEY=
NOTIFICATION_N8N_TOKEN_HEADER_NAME=X-PE-N8N-TOKEN
WHATSAPP_SIMULATED_TO=+56900000000
WHATSAPP_SIMULATED_SENDER=Pilar Estilo
WHATSAPP_TWILIO_API_BASE_URL=https://api.twilio.com
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
# For Twilio WhatsApp sender use format:
# whatsapp:+14155238886
WHATSAPP_TWILIO_FROM=
# Fallback destination when customer contact is not a phone number
WHATSAPP_TWILIO_TO_FALLBACK=+56900000000
WHATSAPP_TWILIO_SENDER_ALIAS=Pilar Estilo
SENDGRID_API_BASE_URL=https://api.sendgrid.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_SENDER_NAME=Pilar Estilo
SENDGRID_TO_FALLBACK=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM_EMAIL=
EMAIL_SMTP_SENDER_NAME=Pilar Estilo
EMAIL_SMTP_AUTH_ENABLED=
EMAIL_SMTP_STARTTLS_ENABLED=
EMAIL_SMTP_SSL_ENABLED=
EMAIL_SMTP_TO_FALLBACK=

# Payment gateway provider
# Options: STUB | MERCADO_PAGO
PAYMENT_GATEWAY_PROVIDER=STUB

# Shared webhook secret for /api/payments/webhooks/gateway (simulation/manual webhook endpoint)
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Stub checkout base URL (used when provider=STUB)
PAYMENT_GATEWAY_STUB_CHECKOUT_BASE_URL=/es/account?tab=orders

# Mercado Pago (used when provider=MERCADO_PAGO)
PAYMENT_GATEWAY_MP_API_BASE_URL=https://api.mercadopago.com
PAYMENT_GATEWAY_MP_ACCESS_TOKEN=
PAYMENT_GATEWAY_MP_SUCCESS_URL=
PAYMENT_GATEWAY_MP_PENDING_URL=
PAYMENT_GATEWAY_MP_FAILURE_URL=
PAYMENT_GATEWAY_MP_NOTIFICATION_URL=
PAYMENT_GATEWAY_MP_WEBHOOK_TOKEN=

# Domain events over Kafka (P5)
# Keep disabled in local unless you want to test event-driven mode.
# Start Kafka container with:
# docker compose -f infra/docker-compose.yml --env-file infra/.env --profile kafka up -d
APP_DOMAIN_EVENTS_KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APP_DOMAIN_EVENTS_KAFKA_TOPIC_PREFIX=pe.domain
APP_DOMAIN_EVENTS_KAFKA_CONSUMER_GROUP_ID=pe-backend-domain-events
APP_DOMAIN_EVENTS_KAFKA_RETRY_BACKOFF_MS=1500
APP_DOMAIN_EVENTS_KAFKA_RETRY_MAX_ATTEMPTS=3
APP_DOMAIN_EVENTS_KAFKA_DLT_SUFFIX=.dlt

# Docker Compose profiles for vps_deploy.sh
# Leave empty for standard deploy (backend monolith only).
# Set to "microservices" to also start product/inventory/order/payment services.
# Set to "microservices,cache" to also start Redis.
# Set to "microservices,cache,observability" for the full stack.
# Full local stack (all services, OpenAI-only): microservices + cache + observability + tracing + kafka
DEPLOY_PROFILES=microservices,cache,observability,tracing,kafka

# Extracted read services (microservices profile)
# Enable remote delegation flags only when running with DEPLOY_PROFILES=microservices.
# Inventory write delegation
# When true, backend reserve/release/confirm calls are delegated to inventory-service.
APP_INVENTORY_REMOTE_ENABLED=true
APP_INVENTORY_REMOTE_BASE_URL=http://inventory-service:8082
# Order read delegation (P6 step 4)
# When true, backend order queries are delegated to order-service.
APP_ORDER_REMOTE_ENABLED=true
# Order write delegation (P6 step 6)
# When true, backend order create/update status commands are delegated to order-service.
APP_ORDER_REMOTE_WRITE_ENABLED=true
APP_ORDER_REMOTE_BASE_URL=http://order-service:8083
# Shared service token used by backend -> order-service internal calls.
APP_ORDER_REMOTE_SERVICE_TOKEN=order-service-internal-token
# Payment read delegation (P6 step 5)
# When true, backend payment queries are delegated to payment-service.
APP_PAYMENT_REMOTE_ENABLED=true
APP_PAYMENT_REMOTE_BASE_URL=http://payment-service:8084
# Shared service token used by backend -> payment-service internal calls.
APP_PAYMENT_REMOTE_SERVICE_TOKEN=payment-service-internal-token

# Product AI pipeline (P9)
APP_PRODUCT_AI_ENABLED=true
APP_PRODUCT_AI_ENGINE=openai_backend
APP_PRODUCT_AI_MAX_ATTEMPTS=3
APP_PRODUCT_AI_RETRY_BACKOFF_MS=2000
APP_PRODUCT_AI_WORKER_CRON=*/20 * * * * *
APP_PRODUCT_AI_WORKER_BATCH_SIZE=5
APP_PRODUCT_AI_IMAGE_TARGET_WIDTH=1024
APP_PRODUCT_AI_IMAGE_TARGET_HEIGHT=1280
APP_PRODUCT_AI_IMAGE_WEB_WIDTH=1024
APP_PRODUCT_AI_IMAGE_WEB_HEIGHT=1280
APP_PRODUCT_AI_IMAGE_WEB_JPEG_QUALITY=0.88
APP_PRODUCT_AI_IMAGE_THUMB_WIDTH=320
APP_PRODUCT_AI_IMAGE_THUMB_HEIGHT=400
APP_PRODUCT_AI_IMAGE_THUMB_JPEG_QUALITY=0.82
APP_PRODUCT_AI_OPENAI_BASE_URL=https://api.openai.com/v1
APP_PRODUCT_AI_OPENAI_API_KEY=
APP_PRODUCT_AI_OPENAI_MODEL=gpt-image-1
APP_PRODUCT_AI_TIMEOUT_MS=180000

# API gateway guardrails (backend-facing rate limits for sensitive public endpoints)
# Applies to: POST /api/auth/login, POST /api/auth/register,
#             POST /api/payments/webhooks/gateway[/*]
APP_GATEWAY_RATE_LIMIT_ENABLED=true
APP_GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
APP_GATEWAY_RATE_LIMIT_LOGIN_MAX_REQUESTS=12
APP_GATEWAY_RATE_LIMIT_REGISTER_MAX_REQUESTS=6
APP_GATEWAY_RATE_LIMIT_WEBHOOK_MAX_REQUESTS=180

# Redis cache baseline (P7)
# Start Redis with:
# docker compose -f infra/docker-compose.yml --env-file infra/.env --profile cache up -d redis
APP_CACHE_REDIS_ENABLED=true
APP_CACHE_REDIS_TTL_SECONDS=300
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Horizontal backend scaling (P7)
# Scale backend replicas behind Caddy:
# docker compose -f infra/docker-compose.yml --env-file infra/.env up -d --scale backend=2

# Postgres read replica for catalog queries (P7 - product-service)
# Keep disabled until you have a real read replica endpoint.
APP_DB_READ_REPLICA_ENABLED=false
APP_DB_READ_REPLICA_URL=
APP_DB_READ_REPLICA_USERNAME=
APP_DB_READ_REPLICA_PASSWORD=
APP_DB_READ_REPLICA_DRIVER_CLASS_NAME=org.postgresql.Driver

# Observability (P7)
# Start it with:
# docker compose -f infra/docker-compose.yml --env-file infra/.env --profile observability up -d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Distributed tracing (OpenTelemetry)
# Start tracing-only profile:
# docker compose -f infra/docker-compose.yml --env-file infra/.env --profile tracing up -d
# Or use observability profile (includes Tempo + OTel Collector + Grafana + Prometheus)
APP_TRACING_ENABLED=true
APP_TRACING_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
APP_TRACING_SAMPLING_PROBABILITY=1.0
