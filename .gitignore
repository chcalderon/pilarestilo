# Node / Frontend
node_modules/
dist/
# Coverage reports: regenerated by `npm run test:coverage`, read by SonarQube from lcov.info
frontend/coverage/
.astro/
*.local

# Java / Maven
target/
*.class
*.jar
*.war
.mvn/wrapper/maven-wrapper.jar
test-output.txt
test-*.txt

# Environment
.env
infra/.env
!infra/.env.example

# Postgres data volume
infra/postgres/

# IDEs
.idea/
*.iml
.vscode/
*.swp
.DS_Store

# Logs
*.log
.worktrees/

.continue/

# Playwright run artifacts (traces, screenshots, .last-run.json) — regenerated on every run
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.cache/
# Uploaded boletas and payment receipts. These carry a RUT, a buyer's name and amounts, which is
# exactly why they live outside the public media root; they must never reach the repository either.
infra/storage/documents/
infra/storage/media/

# Playwright artifacts land wherever the runner was started from, not only under frontend/.
test-results/
playwright-report/

# Per-session lock the Claude Code harness uses to coordinate which local session owns
# scheduled/cron tasks. Rewritten (sessionId/pid/timestamp) every time a session acquires it,
# which made it show up as a dirty file in nearly every commit despite belonging to no one's work.
.claude/scheduled_tasks.lock

# Scratch workspace for superpowers:subagent-driven-development (ledgers, task briefs,
# implementer reports, review packages) -- per-plan, disposable once the branch merges.
.superpowers/
