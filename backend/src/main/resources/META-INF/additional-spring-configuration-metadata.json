  "properties": [
    {
      "name": "app.cache.redis.enabled",
      "type": "java.lang.Boolean",
      "description": "Registers the Redis connection factory. Without a reachable Redis the app will not start.",
      "defaultValue": false
    },
    {
      "name": "app.cache.redis.ttl-seconds",
      "type": "java.lang.Integer",
      "defaultValue": 300
    },
    {
      "name": "app.documents.orphan-sweep.cron",
      "type": "java.lang.String",
      "description": "When to delete uploaded files no document claims.",
      "defaultValue": "0 30 4 * * *"
    },
    {
      "name": "app.documents.orphan-sweep.min-age-hours",
      "type": "java.lang.Integer",
      "description": "How old an unclaimed file must be before the sweep takes it; younger ones are still on their way to being claimed.",
      "defaultValue": 24
    },
    {
      "name": "app.documents.storage-path",
      "type": "java.lang.String",
      "description": "Private root for boletas and transfer receipts; read only through authenticated endpoints.",
      "defaultValue": "./documents"
    },
    {
      "name": "app.domain-events.kafka.consumer-group-id",
      "type": "java.lang.String",
      "defaultValue": "pe-backend-domain-events"
