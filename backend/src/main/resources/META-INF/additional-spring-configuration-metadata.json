{
  "groups": [
    {
      "name": "app",
      "type": "java.lang.Object",
      "description": "Pilar Estilo application settings. Most leaves are injected with @Value rather than @ConfigurationProperties, so they carry no generated metadata; this file declares the namespace so IDEs stop reporting it as an unknown property."
    },
