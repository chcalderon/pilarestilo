---
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import LocaleSwitcher from './LocaleSwitcher.astro';
import CartBadge from '../islands/CartBadge';
import AccountMenu from '../islands/auth/AccountMenu';
import NavNotificationBell from '../islands/NavNotificationBell';
import Icon from './Icon.astro';
import { getCategoryTree } from '../lib/api';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

let categories: { slug: string; labelEs: string; labelEn: string }[] = [];
try {
  const tree = await getCategoryTree();
  categories = tree.flatMap(root =>
    root.children.length > 0
      ? root.children.map(c => ({ slug: c.slug, labelEs: c.nameEs, labelEn: c.nameEn ?? c.nameEs }))
      : [{ slug: root.slug, labelEs: root.nameEs, labelEn: root.nameEn ?? root.nameEs }]
  );
} catch {
  // fallback — empty nav rather than broken page
}
---

<header class="sticky top-0 z-50" id="site-header">
  <div id="nav-utility" class="border-b transition-colors duration-300 bg-pe-black border-pe-white/8">
    <div class="pe-container flex items-center justify-between h-9">
      <p id="nav-shipping" class="pe-eyebrow text-pe-white/40 hidden sm:block">
        {locale === 'es' ? 'Envíos a todo Chile' : 'Shipping across Chile'}
      </p>
      <div class="flex items-center gap-5 ml-auto">
        <button
          id="theme-toggle"
          aria-label="Cambiar tema"
          class="text-pe-white/40 hover:text-pe-rose-soft transition-colors duration-200"
        >
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
               class="hidden">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
          </svg>
        </button>
        <LocaleSwitcher locale={locale} />
        <AccountMenu client:only="react" locale={locale} />
      </div>
    </div>
  </div>

  <div id="nav-main" class="backdrop-blur-sm border-b transition-colors duration-300 bg-pe-black/95 border-pe-white/8">
    <div class="pe-container">
      <nav id="nav-main-row" class="flex items-center justify-between" aria-label="Main navigation">
        <button
          id="nav-search-btn"
          class="text-pe-white/40 hover:text-pe-rose-soft transition-colors duration-200 p-1"
          aria-label={locale === 'es' ? 'Buscar' : 'Search'}
        >
          <Icon name="search" size={18} />
        </button>

        <a href={`/${locale}/`} class="nav-logo-wrap group" aria-label="Pilar Estilo - Inicio">
          <img
            id="nav-logo-full"
            src="/logo-full-dark-ref.png"
            alt="Pilar Estilo - Lujo con proposito"
            width="380"
            height="122"
            class="nav-logo-layer nav-logo-full object-contain"
          />
          <img
            id="nav-logo-compact"
            src="/logo_princ.png"
            alt="Pilar Estilo"
            width="220"
            height="74"
            class="nav-logo-layer nav-logo-compact object-contain"
          />
        </a>

        <div id="nav-actions" class="flex items-center gap-3">
          <NavNotificationBell client:only="react" locale={locale} />
          <a
            href={`/${locale}/wishlist`}
            class="text-pe-white/40 hover:text-pe-rose-soft transition-colors duration-200 p-1"
            aria-label={locale === 'es' ? 'Favoritos' : 'Wishlist'}
            id="nav-wishlist-link"
          >
            <Icon name="heart" size={18} />
          </a>
          <a
            id="nav-cart-link"
            href={`/${locale}/cart`}
            class="relative flex items-center gap-1 text-pe-white/40 hover:text-pe-rose-soft transition-colors duration-200 p-1"
            aria-label={t('nav.cart', locale)}
          >
            <Icon name="shopping-bag" size={20} />
            <CartBadge client:load />
          </a>
        </div>
      </nav>
    </div>
  </div>

  <div id="nav-cats" class="border-b transition-colors duration-300 bg-pe-offwhite border-pe-black/8">
    <div class="pe-container">
      <div class="nav-cats-shell">
        <button
          id="nav-cats-prev"
          type="button"
          class="nav-cats-slide-btn is-hidden"
          data-side="left"
          aria-label={locale === 'es' ? 'Deslizar categorías hacia la izquierda' : 'Slide categories left'}
        >
          <span class="nav-cats-slide-glyph" aria-hidden="true">‹</span>
        </button>

        <div id="nav-cats-scroller" class="hide-scrollbar">
          <ul id="nav-cats-list" class="flex w-max min-w-full items-center gap-0 pr-4 md:pr-0" role="list" aria-label="Product categories">
            <li class="shrink-0">
              <a
                href={`/${locale}/`}
                class="nav-cat-link flex items-center justify-center text-pe-charcoal/70 hover:text-pe-rose-deep transition-colors duration-200 py-3 px-4 border-b-2 border-transparent hover:border-pe-rose"
                aria-label={locale === 'es' ? 'Inicio' : 'Home'}
              >
                <Icon name="home" size={15} strokeWidth={1.6} />
              </a>
            </li>
            <li class="shrink-0">
              <a
                href={`/${locale}/products`}
                class="nav-cat-link block font-sans text-[0.68rem] tracking-[0.22em] uppercase text-pe-charcoal/70 hover:text-pe-rose-deep transition-colors duration-200 py-3 px-4 whitespace-nowrap border-b-2 border-transparent hover:border-pe-rose"
              >
                {locale === 'es' ? 'Todo' : 'All'}
              </a>
            </li>
            {categories.map(cat => (
              <li class="shrink-0">
                <a
                  href={`/${locale}/categories/${cat.slug}`}
                  class="nav-cat-link block font-sans text-[0.68rem] tracking-[0.22em] uppercase text-pe-charcoal/70 hover:text-pe-rose-deep transition-colors duration-200 py-3 px-4 whitespace-nowrap border-b-2 border-transparent hover:border-pe-rose"
                >
                  {locale === 'es' ? cat.labelEs : cat.labelEn}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <button
          id="nav-cats-next"
          type="button"
          class="nav-cats-slide-btn is-hidden"
          data-side="right"
          aria-label={locale === 'es' ? 'Deslizar categorías hacia la derecha' : 'Slide categories right'}
        >
          <span class="nav-cats-slide-glyph" aria-hidden="true">›</span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .hide-scrollbar { scrollbar-width: none; }
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .nav-cats-shell { position: relative; overflow: hidden; }
  #nav-cats-scroller { overflow-x: auto; scroll-behavior: smooth; width: 100%; min-width: 0; }
  #nav-cats-list > li { scroll-snap-align: start; }
  .nav-cats-slide-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--pe-border) 82%, transparent);
    background-color: color-mix(in srgb, var(--pe-surface) 94%, transparent);
    color: var(--pe-charcoal);
    z-index: 2;
    transition: opacity 220ms ease, transform 220ms ease;
    opacity: 1;
    pointer-events: auto;
  }
  .nav-cats-slide-btn[data-side="left"] { left: 0.15rem; }
  .nav-cats-slide-btn[data-side="right"] { right: 0.15rem; }
  .nav-cats-slide-btn.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%) scale(0.94);
  }
  .nav-cats-shell::before,
  .nav-cats-shell::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1.5rem;
    pointer-events: none;
    z-index: 1;
  }
  .nav-cats-shell::before {
    left: 0;
    background: linear-gradient(to right, var(--pe-surface-soft), rgba(0, 0, 0, 0));
  }
  .nav-cats-shell::after {
    right: 0;
    background: linear-gradient(to left, var(--pe-surface-soft), rgba(0, 0, 0, 0));
  }
  .nav-cats-slide-glyph {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 1.05rem;
    line-height: 1;
    transform: translateY(-0.5px);
  }

  .nav-logo-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(78vw, 760px);
    height: 190px;
    transition: width 320ms ease, height 320ms ease;
  }

  .nav-logo-layer {
    position: absolute;
    top: 50%;
    left: 50%;
    will-change: opacity, transform;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .nav-logo-full {
    opacity: 1;
    height: 176px;
    max-width: min(78vw, 760px);
    filter: drop-shadow(0 1px 2px rgba(26, 26, 26, 0.28));
    z-index: 1;
    transition: none;
    transform: translate(-50%, -50%) scale(1.14);
  }

  .nav-logo-compact {
    opacity: 0;
    height: 58px;
    max-width: min(42vw, 240px);
    transform: translate(-50%, -50%) scale(0.96);
    filter: drop-shadow(0 1px 2px rgba(26, 26, 26, 0.24));
    z-index: 2;
    transition: opacity 320ms ease, transform 320ms ease;
  }

  #site-header:not(.logo-compact) #nav-main-row {
    height: 200px;
    transition: height 320ms ease;
  }

  #site-header.logo-compact #nav-main-row {
    height: 78px;
  }

  #site-header.logo-compact .nav-logo-wrap {
    width: min(42vw, 240px);
    height: 74px;
  }

  #site-header.logo-intro .nav-logo-full {
    animation: nav-logo-fade-in 720ms ease both;
  }

  #site-header.logo-compact .nav-logo-full {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.96);
    visibility: hidden;
  }

  #site-header.logo-compact .nav-logo-compact {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    visibility: visible;
  }

  #site-header:not(.logo-compact) .nav-logo-full {
    opacity: 1;
    visibility: visible;
  }

  #site-header:not(.logo-compact) .nav-logo-compact {
    visibility: hidden;
  }

  @keyframes nav-logo-fade-in {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.02);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.12);
    }
  }

  #site-header.theme-light #nav-utility { background-color: var(--pe-surface); border-color: var(--pe-border); }
  #site-header.theme-light #nav-main { background-color: color-mix(in srgb, var(--pe-surface) 95%, transparent); border-color: var(--pe-border); }
  #site-header.theme-light #nav-cats { background-color: var(--pe-surface-soft); border-color: var(--pe-border); }
  #site-header.theme-light #nav-shipping { color: var(--pe-nav-subtle); }
  #site-header.theme-light #theme-toggle { color: var(--pe-nav-subtle); }
  #site-header.theme-light #nav-search-btn { color: var(--pe-nav-subtle); }
  #site-header.theme-light #nav-wishlist-link { color: var(--pe-nav-subtle); }
  #site-header.theme-light #nav-cart-link { color: var(--pe-nav-subtle); }

  @media (max-width: 768px) {
    #nav-cats-scroller {
      scroll-snap-type: x proximity;
      padding-inline: 1.5rem;
    }

    #nav-cats-list {
      min-width: max-content;
      padding-right: 2rem;
    }

    .nav-logo-wrap {
      width: min(88vw, 620px);
      height: 156px;
    }

    .nav-logo-full {
      height: 144px;
      max-width: min(88vw, 620px);
    }

    .nav-logo-compact {
      height: 52px;
      max-width: min(46vw, 220px);
    }

    #site-header:not(.logo-compact) #nav-main-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas:
        "search . actions"
        "logo logo logo";
      align-items: center;
      row-gap: 0.45rem;
      height: auto;
      padding-top: 0.5rem;
      padding-bottom: 0.45rem;
    }

    #site-header:not(.logo-compact) #nav-search-btn {
      grid-area: search;
      justify-self: start;
    }

    #site-header:not(.logo-compact) #nav-actions {
      grid-area: actions;
      justify-self: end;
    }

    #site-header:not(.logo-compact) .nav-logo-wrap {
      grid-area: logo;
      justify-self: center;
    }

    #site-header.logo-compact #nav-main-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }

    #site-header.logo-compact .nav-logo-wrap {
      width: min(46vw, 220px);
      height: 68px;
    }
  }
</style>

<script>
  const STORAGE_THEME_KEY = 'pe-theme';
  const STORAGE_MODE_KEY = 'pe-theme-mode';
  const prefersDarkQuery = window.matchMedia('(prefers-color-scheme: dark)');
  const COMPACT_ON_SCROLL_Y = 120;
  const EXPAND_ON_SCROLL_Y = 16;
  let isCompact = false;
  let lastScrollY = 0;
  let transitionLocked = false;
  let transitionUnlockTimer: number | undefined;

  function initCategorySlider() {
    const scroller = document.getElementById('nav-cats-scroller') as HTMLDivElement | null;
    const prevBtn = document.getElementById('nav-cats-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('nav-cats-next') as HTMLButtonElement | null;
    if (!scroller || !prevBtn || !nextBtn) return;
    if (scroller.dataset.sliderReady === '1') return;
    scroller.dataset.sliderReady = '1';

    const updateButtons = () => {
      const firstItem = scroller.querySelector('li') as HTMLLIElement | null;
      const lastItem = scroller.querySelector('li:last-child') as HTMLLIElement | null;
      const canScroll = scroller.scrollWidth - scroller.clientWidth > 4;
      if (!firstItem || !lastItem || !canScroll) {
        prevBtn.classList.add('is-hidden');
        nextBtn.classList.add('is-hidden');
        return;
      }

      const scrollerRect = scroller.getBoundingClientRect();
      const firstRect = firstItem.getBoundingClientRect();
      const lastRect = lastItem.getBoundingClientRect();
      const atStart = firstRect.left >= scrollerRect.left - 1;
      const atEnd = lastRect.right <= scrollerRect.right + 1;
      prevBtn.classList.toggle('is-hidden', atStart);
      nextBtn.classList.toggle('is-hidden', atEnd);
    };

    const scrollByStep = (dir: -1 | 1) => {
      const step = Math.max(scroller.clientWidth * 0.7, 120);
      scroller.scrollBy({ left: dir * step, behavior: 'smooth' });
    };

    prevBtn.addEventListener('click', () => scrollByStep(-1));
    nextBtn.addEventListener('click', () => scrollByStep(1));
    scroller.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons, { passive: true });
    window.addEventListener('load', updateButtons, { passive: true });
    updateButtons();
    requestAnimationFrame(updateButtons);
    window.setTimeout(updateButtons, 180);
  }

  function safeGet(key: string) {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function safeSet(key: string, value: string) {
    try {
      localStorage.setItem(key, value);
    } catch {
      // Ignore storage write failures.
    }
  }

  function applyTheme(theme: string) {
    const header = document.getElementById('site-header');
    const fullLogo = document.getElementById('nav-logo-full') as HTMLImageElement | null;
    const moonIcon = document.getElementById('icon-moon');
    const sunIcon = document.getElementById('icon-sun');
    const source = getMode();

    if (theme === 'light') {
      header?.classList.add('theme-light');
      if (fullLogo) fullLogo.src = '/logo-full-light-ref.png';
      moonIcon?.classList.add('hidden');
      sunIcon?.classList.remove('hidden');
      document.documentElement.setAttribute('data-theme', 'light');
    } else {
      header?.classList.remove('theme-light');
      if (fullLogo) fullLogo.src = '/logo-full-dark-ref.png';
      moonIcon?.classList.remove('hidden');
      sunIcon?.classList.add('hidden');
      document.documentElement.setAttribute('data-theme', 'dark');
    }
    document.documentElement.setAttribute('data-theme-source', source);
    document.documentElement.setAttribute('data-theme-system', getSystemTheme());
  }

  function getStoredTheme() {
    const raw = safeGet(STORAGE_THEME_KEY);
    if (raw === 'light' || raw === 'dark') {
      return raw;
    }
    if (getMode() === 'manual') {
      safeSet(STORAGE_THEME_KEY, 'dark');
      return 'dark';
    }
    return null;
  }

  function getMode() {
    const mode = safeGet(STORAGE_MODE_KEY);
    return mode === 'manual' ? 'manual' : 'system';
  }

  function getSystemTheme() {
    return prefersDarkQuery.matches ? 'dark' : 'light';
  }

  function getRootTheme() {
    const raw = document.documentElement.getAttribute('data-theme');
    return raw === 'light' || raw === 'dark' ? raw : null;
  }

  function setCompactState(nextCompact: boolean) {
    const header = document.getElementById('site-header');
    if (!header) return;
    if (isCompact === nextCompact || transitionLocked) return;

    transitionLocked = true;
    if (transitionUnlockTimer !== undefined) {
      window.clearTimeout(transitionUnlockTimer);
    }

    isCompact = nextCompact;
    header.classList.toggle('logo-compact', nextCompact);
    transitionUnlockTimer = window.setTimeout(() => {
      transitionLocked = false;
    }, 260);
  }

  function applyLogoScrollState() {
    const header = document.getElementById('site-header');
    if (!header) return;
    const y = window.scrollY;
    const scrollingDown = y > lastScrollY + 1;
    const scrollingUp = y < lastScrollY - 1;

    if (!isCompact && scrollingDown && y >= COMPACT_ON_SCROLL_Y) {
      setCompactState(true);
      lastScrollY = y;
      return;
    }

    if (isCompact && scrollingUp && y <= EXPAND_ON_SCROLL_Y) {
      setCompactState(false);
    }

    lastScrollY = y;
  }

  const mode = getMode();
  const storedTheme = getStoredTheme();
  const initialTheme = getRootTheme() ?? storedTheme ?? getSystemTheme();
  if (!storedTheme) {
    safeSet(STORAGE_THEME_KEY, initialTheme);
  }
  safeSet(STORAGE_MODE_KEY, mode);
  applyTheme(initialTheme);
  lastScrollY = window.scrollY;
  applyLogoScrollState();
  initCategorySlider();
  document.getElementById('site-header')?.classList.add('logo-intro');

  document.getElementById('nav-search-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-search'));
  });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || getSystemTheme();
    const next = current === 'dark' ? 'light' : 'dark';
    safeSet(STORAGE_THEME_KEY, next);
    safeSet(STORAGE_MODE_KEY, 'manual');
    applyTheme(next);
  });

  window.addEventListener('scroll', applyLogoScrollState, { passive: true });
</script>
