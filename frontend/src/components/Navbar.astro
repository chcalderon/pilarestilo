---
import type { Locale } from '../i18n/index';
import LocaleSwitcher from './LocaleSwitcher.astro';
import CartPopover from '../islands/cart/CartPopover';
import AccountMenu from '../islands/auth/AccountMenu';
import NavNotificationBell from '../islands/NavNotificationBell';
import Icon from './Icon.astro';
import CategoryTreeNav from './CategoryTreeNav.astro';
import { getNavigationTree, type CategoryTreeNode, type NavigationSectionDto } from '../lib/api';
import MegaMenuTray from '../islands/nav/MegaMenuTray';
import MobileNavOverlay from '../islands/nav/MobileNavOverlay';

export interface Props {
  locale: Locale;
  /** The home hero earns the full logo entrance; every other page starts already compact. */
  isHome?: boolean;
}

const { locale, isHome = false } = Astro.props;

let navTree: import('../lib/api').NavigationTreeDto = { sections: [] };
try {
  navTree = await getNavigationTree(locale);
} catch {
  // fallback — empty nav
}

function toCategoryTreeNode(
  child: NavigationSectionDto['children'][number],
  parentId: string,
  sortOrder: number,
): CategoryTreeNode {
  return {
    id: child.id,
    parentId,
    slug: child.slug,
    nameEs: child.name,
    nameEn: child.name,
    sortOrder,
    active: true,
    featured: child.featured,
    imageUrl: child.imageUrl,
    menuVisible: true,
    categoryType: 'GENERIC',
    heroImageUrl: undefined,
    children: child.children.map((grandChild, index) => toCategoryTreeNode(grandChild, child.id, index)),
  };
}

const navCategoryRoots: CategoryTreeNode[] = navTree.sections.map((section, index) => ({
  id: section.rootCategoryId,
  parentId: null,
  slug: section.rootCategorySlug,
  nameEs: section.rootCategoryName,
  nameEn: section.rootCategoryName,
  sortOrder: index,
  active: true,
  featured: false,
  imageUrl: section.heroImageUrl,
  menuVisible: true,
  categoryType: 'GENERIC',
  heroImageUrl: section.heroImageUrl,
  children: section.children.map((child, childIndex) => toCategoryTreeNode(child, section.rootCategoryId, childIndex)),
}));
---

<header class="sticky top-0 z-50" class:list={[!isHome && 'logo-compact']} id="site-header">
  <div id="nav-utility" class="border-b transition-colors duration-300 bg-pe-black border-pe-white/8">
    <div id="nav-utility-grid" class="pe-container">
      <p id="nav-shipping" class="pe-eyebrow text-pe-on-dark-muted whitespace-nowrap overflow-hidden text-ellipsis">
        {locale === 'es' ? 'Despachos a todo Chile' : 'Shipping across Chile'}
      </p>
      <button
        id="theme-toggle"
        aria-label="Cambiar tema"
        class="icon-hit rounded-full text-pe-on-dark-muted hover:text-pe-rose-soft hover:bg-pe-white/8 transition-colors duration-200"
      >
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
             class="hidden">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
      </button>
      <div id="nav-locale">
        <LocaleSwitcher locale={locale} />
      </div>
      <div id="nav-account">
        <AccountMenu client:only="react" locale={locale} />
      </div>
    </div>
  </div>

  <div id="nav-main" class="backdrop-blur-xs border-b transition-colors duration-300 bg-pe-black/95 border-pe-white/8">
    <div class="pe-container">
      <nav id="nav-main-row" class="flex items-center justify-between" aria-label="Main navigation">
        <div class="flex items-center gap-1">
          <button
            id="nav-hamburger"
            class="icon-hit lg:hidden rounded-full text-pe-on-dark-muted hover:text-pe-rose-soft hover:bg-pe-white/8 transition-colors duration-200"
            aria-label={locale === 'es' ? 'Abrir menú' : 'Open menu'}
            aria-expanded="false"
            aria-controls="mobile-nav-overlay"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </button>
          <button
            id="nav-search-btn"
            class="icon-hit rounded-full text-pe-on-dark-muted hover:text-pe-rose-soft hover:bg-pe-white/8 transition-colors duration-200"
            aria-label={locale === 'es' ? 'Buscar' : 'Search'}
          >
            <Icon name="search" size={18} />
          </button>
        </div>

        <a href={`/${locale}/`} class="nav-logo-wrap group" aria-label="Pilar Estilo - Inicio">
          <img
            id="nav-logo-full"
            src="/logo-full.png"
            alt="Pilar Estilo - Lujo con proposito"
            width="380"
            height="122"
            class="nav-logo-layer nav-logo-full object-contain"
          />
          <img
            id="nav-logo-compact"
            src="/logo-isotipo.png"
            alt="Pilar Estilo"
            width="220"
            height="74"
            class="nav-logo-layer nav-logo-compact object-contain"
          />
        </a>

        <div id="nav-actions" class="flex items-center gap-3">
          <NavNotificationBell client:only="react" locale={locale} />
          <a
            href={`/${locale}/wishlist`}
            class="icon-hit rounded-full text-pe-on-dark-muted hover:text-pe-rose-soft hover:bg-pe-white/8 transition-colors duration-200"
            aria-label={locale === 'es' ? 'Favoritos' : 'Wishlist'}
            id="nav-wishlist-link"
          >
            <Icon name="heart" size={18} />
          </a>
          <CartPopover client:load locale={locale} />
        </div>
      </nav>
    </div>
  </div>

  {/* Desktop mega menu trigger bar - hidden on mobile */}
  <div id="nav-mega-bar" class="hidden lg:block border-b transition-colors duration-300 bg-pe-black border-pe-white/8" aria-label="Main categories">
    <div class="pe-container">
      <ul class="flex items-center gap-0 h-10" role="menubar" aria-label={locale === 'es' ? 'Categorías' : 'Categories'}>
        <li>
          <a
            href={`/${locale}/`}
            class="block text-pe-on-dark-muted hover:text-pe-rose-soft transition-colors px-4 h-10 flex items-center"
            aria-label={locale === 'es' ? 'Inicio' : 'Home'}
          >
            <Icon name="home" size={15} strokeWidth={1.6} />
          </a>
        </li>
        <li>
          <a href={`/${locale}/products`}
             class="block font-sans text-[0.63rem] tracking-[0.2em] uppercase text-pe-on-dark-muted hover:text-pe-rose-soft transition-colors px-4 h-10 flex items-center">
            {locale === 'es' ? 'Todo' : 'All'}
          </a>
        </li>
        {navTree.sections.map((section) => (
          <li
            class="relative"
            data-mega-root={section.rootCategorySlug}
          >
            <a
              href={`/${locale}/categories/${section.rootCategorySlug}`}
              class="mega-trigger block font-sans text-[0.63rem] tracking-[0.2em] uppercase text-pe-on-dark-muted hover:text-pe-rose-soft transition-colors px-4 h-10 flex items-center gap-1.5"
              role="menuitem"
              aria-haspopup="true"
              aria-expanded="false"
              data-slug={section.rootCategorySlug}
            >
              {section.rootCategoryName}
              {section.children.length > 0 && (
                <span class="text-[0.55rem] opacity-50" aria-hidden="true">▾</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  {/* MegaMenuTray island - desktop only */}
  <MegaMenuTray
    client:load
    sections={navTree.sections}
    locale={locale}
  />

  <div id="mobile-nav-overlay">
    <MobileNavOverlay client:load sections={navTree.sections} locale={locale} />
  </div>

  <div id="nav-cats" class="block lg:hidden border-b transition-colors duration-300 bg-pe-offwhite border-pe-black/8">
    <div class="pe-container">
      <div class="nav-cats-shell">
        <button
          id="nav-cats-prev"
          type="button"
          class="nav-cats-slide-btn is-hidden"
          data-side="left"
          aria-label={locale === 'es' ? 'Deslizar categorías hacia la izquierda' : 'Slide categories left'}
        >
          <span class="nav-cats-slide-glyph" aria-hidden="true">‹</span>
        </button>

        <div id="nav-cats-scroller" class="hide-scrollbar">
          <ul id="nav-cats-list" class="flex w-max min-w-full items-center gap-0 pr-4 md:pr-0" role="list" aria-label="Product categories">
            <li class="shrink-0">
              <a
                href={`/${locale}/`}
                class="nav-cat-link flex items-center justify-center text-pe-muted hover:text-pe-rose-ink transition-colors duration-200 py-3 px-4 border-b-2 border-transparent hover:border-pe-rose"
                aria-label={locale === 'es' ? 'Inicio' : 'Home'}
              >
                <Icon name="home" size={15} strokeWidth={1.6} />
              </a>
            </li>
            <li class="shrink-0">
              <a
                href={`/${locale}/products`}
                class="nav-cat-link block font-sans text-[0.68rem] tracking-[0.22em] uppercase text-pe-muted hover:text-pe-rose-ink transition-colors duration-200 py-3 px-4 whitespace-nowrap border-b-2 border-transparent hover:border-pe-rose"
              >
                {locale === 'es' ? 'Todo' : 'All'}
              </a>
            </li>
            {navCategoryRoots.map((root) => {
              const rootLabel = locale === 'es' ? root.nameEs : (root.nameEn || root.nameEs);
              const rootChildren = (root.children ?? []).filter((child) => child.active);
              const hasChildren = rootChildren.length > 0;

              return (
                <li class="shrink-0 nav-cat-root">
                  {hasChildren ? (
                    <details class="nav-cat-dropdown" data-nav-cat-dropdown>
                      <summary class="nav-cat-link nav-cat-summary block font-sans text-[0.68rem] tracking-[0.22em] uppercase text-pe-muted hover:text-pe-rose-ink transition-colors duration-200 py-3 px-4 whitespace-nowrap border-b-2 border-transparent hover:border-pe-rose">
                        <span>{rootLabel}</span>
                        <span class="nav-cat-caret" aria-hidden="true">▾</span>
                      </summary>
                      <div class="nav-cat-panel">
                        <a href={`/${locale}/categories/${root.slug}`} class="nav-cat-panel-root-link">
                          {locale === 'es' ? `Ver todo en ${rootLabel}` : `View all in ${rootLabel}`}
                        </a>
                        <div class="nav-cat-panel-desktop">
                          <CategoryTreeNav
                            nodes={rootChildren}
                            locale={locale}
                            routeMode="categories"
                            viewMode="header"
                            maxDepth={3}
                            forceExpanded={true}
                          />
                        </div>
                        <div class="nav-cat-panel-mobile">
                          <CategoryTreeNav
                            nodes={rootChildren}
                            locale={locale}
                            routeMode="categories"
                            viewMode="header"
                            maxDepth={3}
                          />
                        </div>
                      </div>
                    </details>
                  ) : (
                    <a
                      href={`/${locale}/categories/${root.slug}`}
                      class="nav-cat-link block font-sans text-[0.68rem] tracking-[0.22em] uppercase text-pe-muted hover:text-pe-rose-ink transition-colors duration-200 py-3 px-4 whitespace-nowrap border-b-2 border-transparent hover:border-pe-rose"
                    >
                      {rootLabel}
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </div>

        <button
          id="nav-cats-next"
          type="button"
          class="nav-cats-slide-btn is-hidden"
          data-side="right"
          aria-label={locale === 'es' ? 'Deslizar categorías hacia la derecha' : 'Slide categories right'}
        >
          <span class="nav-cats-slide-glyph" aria-hidden="true">›</span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  #nav-utility-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    grid-template-areas: "shipping theme locale account";
    align-items: center;
    column-gap: 1.1rem;
    height: 2.25rem;
  }
  #nav-shipping { grid-area: shipping; }
  #theme-toggle { grid-area: theme; justify-self: end; }
  #nav-locale { grid-area: locale; justify-self: end; }
  #nav-account { grid-area: account; justify-self: end; }

  .hide-scrollbar { scrollbar-width: none; }
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  #nav-cats { overflow: visible; }
  .nav-cats-shell { position: relative; overflow: visible; }
  #nav-cats-scroller { overflow-x: auto; scroll-behavior: smooth; }
  #nav-cats-list > li { scroll-snap-align: start; }
  .nav-cat-root {
    position: relative;
  }
  .nav-cat-dropdown > summary {
    list-style: none;
    cursor: pointer;
  }
  .nav-cat-dropdown > summary::-webkit-details-marker {
    display: none;
  }
  .nav-cat-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .nav-cat-caret {
    font-size: 0.62rem;
    transform: translateY(-1px);
    transition: transform 200ms ease;
  }
  .nav-cat-dropdown[open] .nav-cat-caret {
    transform: translateY(-1px) rotate(180deg);
  }
  .nav-cat-panel {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 80;
    width: min(20.5rem, 82vw);
    max-height: min(62vh, 30rem);
    overflow: auto;
    padding: 0.62rem;
    border: 1px solid color-mix(in srgb, var(--pe-border) 92%, transparent);
    background: color-mix(in srgb, var(--pe-surface) 96%, transparent);
    box-shadow:
      0 20px 40px -24px rgba(0, 0, 0, 0.35),
      0 10px 14px -12px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top left;
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0ms linear 180ms;
  }
  .nav-cat-dropdown[open] > .nav-cat-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0ms linear 0ms;
  }
  .nav-cat-panel-desktop {
    display: none;
  }
  .nav-cat-panel-mobile {
    display: block;
  }
  .nav-cat-panel-root-link {
    display: block;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--pe-rose-deep) 84%, var(--pe-charcoal) 16%);
    padding: 0.35rem 0.45rem 0.42rem;
    margin-bottom: 0.28rem;
    border-bottom: 1px solid color-mix(in srgb, var(--pe-border) 78%, transparent);
  }
  .nav-cat-panel-root-link:hover {
    color: var(--pe-rose-deep);
  }
  .nav-cats-slide-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--pe-border) 82%, transparent);
    background-color: color-mix(in srgb, var(--pe-surface) 94%, transparent);
    color: var(--pe-charcoal);
    z-index: 2;
    transition: opacity 220ms ease, transform 220ms ease;
    opacity: 1;
    pointer-events: auto;
  }
  .nav-cats-slide-btn[data-side="left"] { left: 0.15rem; }
  .nav-cats-slide-btn[data-side="right"] { right: 0.15rem; }
  .nav-cats-slide-btn.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%) scale(0.94);
  }
  .nav-cats-shell::before,
  .nav-cats-shell::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1.5rem;
    pointer-events: none;
    z-index: 1;
  }
  .nav-cats-shell::before {
    left: 0;
    background: linear-gradient(to right, var(--pe-surface-soft), rgba(0, 0, 0, 0));
  }
  .nav-cats-shell::after {
    right: 0;
    background: linear-gradient(to left, var(--pe-surface-soft), rgba(0, 0, 0, 0));
  }
  .nav-cats-slide-glyph {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 1.05rem;
    line-height: 1;
    transform: translateY(-0.5px);
  }

  .nav-logo-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(78vw, 760px);
    height: 190px;
    transition: width 360ms cubic-bezier(0.22, 1, 0.36, 1), height 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-logo-layer {
    position: absolute;
    top: 50%;
    left: 50%;
    will-change: opacity, transform;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .nav-logo-full {
    opacity: 1;
    height: 176px;
    max-width: min(78vw, 760px);
    filter: drop-shadow(0 1px 2px rgba(26, 26, 26, 0.28));
    z-index: 1;
    transform: translate(-50%, -50%) scale(1.14);
    /* compact→expanded: full logo fades IN with delay (compact fades out first) */
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1) 80ms,
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1) 80ms,
      visibility 0ms linear 0ms;
  }

  .nav-logo-compact {
    opacity: 0;
    height: 58px;
    max-width: min(42vw, 240px);
    transform: translate(-50%, -50%) scale(0.96);
    filter: drop-shadow(0 1px 2px rgba(26, 26, 26, 0.24));
    z-index: 2;
    /* compact→expanded: compact logo fades OUT quickly */
    transition:
      opacity 200ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0ms linear 200ms;
  }

  #site-header:not(.logo-compact) #nav-main-row {
    height: 200px;
    transition: height 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #site-header.logo-compact #nav-main-row {
    height: 78px;
  }

  #site-header.logo-compact .nav-logo-wrap {
    width: min(42vw, 240px);
    height: 74px;
  }

  #site-header.logo-intro .nav-logo-full {
    animation: nav-logo-fade-in 720ms ease both;
  }

  #site-header.logo-compact .nav-logo-full {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.94);
    visibility: hidden;
    /* expanded→compact: full logo fades OUT */
    transition:
      opacity 260ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 260ms cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0ms linear 260ms;
  }

  #site-header.logo-compact .nav-logo-compact {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    visibility: visible;
    /* expanded→compact: compact logo fades IN with delay (full fades out first) */
    transition:
      opacity 380ms cubic-bezier(0.22, 1, 0.36, 1) 80ms,
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1) 80ms,
      visibility 0ms linear 0ms;
  }

  #site-header:not(.logo-compact) .nav-logo-full {
    opacity: 1;
    visibility: visible;
  }

  #site-header:not(.logo-compact) .nav-logo-compact {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-logo-full,
    .nav-logo-compact,
    #site-header.logo-compact .nav-logo-full,
    #site-header.logo-compact .nav-logo-compact {
      transition: opacity 0.01ms, transform 0.01ms, visibility 0ms !important;
      animation: none !important;
    }
  }

  @keyframes nav-logo-fade-in {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.02);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.12);
    }
  }

  #site-header.theme-light #nav-utility { background-color: var(--pe-surface); border-color: var(--pe-border); }
  #site-header.theme-light #nav-main { background-color: color-mix(in srgb, var(--pe-surface) 95%, transparent); border-color: var(--pe-border); }
  #site-header.theme-light #nav-cats { background-color: var(--pe-surface-soft); border-color: var(--pe-border); }
  #site-header.theme-light #nav-shipping { color: var(--pe-nav-subtle); }
  #site-header.theme-light #theme-toggle { color: var(--pe-nav-subtle); }
  #site-header.theme-light #nav-search-btn { color: var(--pe-nav-subtle); }
  #site-header.theme-light #nav-wishlist-link { color: var(--pe-nav-subtle); }
  #site-header.theme-light #nav-cart-link { color: var(--pe-nav-subtle); }

  @media (max-width: 768px) {
    #nav-cats-scroller {
      scroll-snap-type: x proximity;
      padding-inline: 1.5rem;
    }

    #nav-cats-list {
      min-width: max-content;
      padding-right: 2rem;
    }

    .nav-logo-wrap {
      width: min(88vw, 620px);
      height: 156px;
    }

    .nav-logo-full {
      height: 144px;
      max-width: min(88vw, 620px);
    }

    .nav-logo-compact {
      height: 52px;
      max-width: min(46vw, 220px);
    }

    #site-header:not(.logo-compact) #nav-main-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas:
        "search . actions"
        "logo logo logo";
      align-items: center;
      row-gap: 0.45rem;
      height: auto;
      padding-top: 0.5rem;
      padding-bottom: 0.45rem;
    }

    #site-header:not(.logo-compact) #nav-main-row > div:first-child {
      grid-area: search;
      justify-self: start;
    }

    #site-header:not(.logo-compact) #nav-actions {
      grid-area: actions;
      justify-self: end;
    }

    #site-header:not(.logo-compact) .nav-logo-wrap {
      grid-area: logo;
      justify-self: center;
    }

    #site-header.logo-compact #nav-main-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }

    #site-header.logo-compact .nav-logo-wrap {
      width: min(46vw, 220px);
      height: 68px;
    }

    .nav-cat-panel {
      width: min(19rem, 88vw);
      max-height: min(56vh, 24rem);
    }
  }

  @media (min-width: 1024px) {
    .nav-cat-panel {
      border-top: 1px solid color-mix(in srgb, var(--pe-rose) 34%, transparent);
      padding: 0.7rem 0.78rem 0.82rem;
      border-radius: 0 0 0.35rem 0.35rem;
      transform-origin: top center;
      transform: translateY(-12px) scale(0.995);
    }

    .nav-cat-panel-desktop {
      display: block;
    }

    .nav-cat-panel-mobile {
      display: none;
    }
  }

  @media (max-width: 1024px) {
    #nav-utility-grid {
      height: auto;
      padding-top: 0.28rem;
      padding-bottom: 0.28rem;
      row-gap: 0.28rem;
      column-gap: 0.75rem;
      grid-template-columns: auto auto minmax(0, 1fr) auto;
      grid-template-areas:
        "shipping shipping shipping shipping"
        "theme locale . account";
    }

    #nav-shipping {
      font-size: 0.58rem;
      letter-spacing: 0.22em;
      justify-self: center;
      text-align: center;
      max-width: 100%;
    }

    #theme-toggle { justify-self: end; }
    #nav-locale { justify-self: start; }
    #nav-account { justify-self: end; }
  }
</style>

<script>
  const COMPACT_ON_SCROLL_Y = 120;
  const EXPAND_ON_SCROLL_Y = 16;
  // Non-home pages render already-compact server-side (see isHome in Navbar.astro); read that
  // instead of assuming expanded, or the first scroll event fights the state it starts in.
  let isCompact = document.getElementById('site-header')?.classList.contains('logo-compact') ?? false;
  let lastScrollY = 0;
  let transitionLocked = false;
  let transitionUnlockTimer: number | undefined;

  function initCategorySlider() {
    const scroller = document.getElementById('nav-cats-scroller') as HTMLDivElement | null;
    const prevBtn = document.getElementById('nav-cats-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('nav-cats-next') as HTMLButtonElement | null;
    if (!scroller || !prevBtn || !nextBtn) return;
    if (scroller.dataset.sliderReady === '1') return;
    scroller.dataset.sliderReady = '1';

    const updateButtons = () => {
      const firstItem = scroller.querySelector('li') as HTMLLIElement | null;
      const lastItem = scroller.querySelector('li:last-child') as HTMLLIElement | null;
      const canScroll = scroller.scrollWidth - scroller.clientWidth > 4;
      if (!firstItem || !lastItem || !canScroll) {
        prevBtn.classList.add('is-hidden');
        nextBtn.classList.add('is-hidden');
        return;
      }

      const scrollerRect = scroller.getBoundingClientRect();
      const firstRect = firstItem.getBoundingClientRect();
      const lastRect = lastItem.getBoundingClientRect();
      const atStart = firstRect.left >= scrollerRect.left - 1;
      const atEnd = lastRect.right <= scrollerRect.right + 1;
      prevBtn.classList.toggle('is-hidden', atStart);
      nextBtn.classList.toggle('is-hidden', atEnd);
    };

    const scrollByStep = (dir: -1 | 1) => {
      const step = Math.max(scroller.clientWidth * 0.7, 120);
      scroller.scrollBy({ left: dir * step, behavior: 'smooth' });
    };

    prevBtn.addEventListener('click', () => scrollByStep(-1));
    nextBtn.addEventListener('click', () => scrollByStep(1));
    scroller.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons, { passive: true });
    window.addEventListener('load', updateButtons, { passive: true });
    updateButtons();
    requestAnimationFrame(updateButtons);
    window.setTimeout(updateButtons, 180);
  }

  function initCategoryDropdowns() {
    const dropdowns = Array.from(document.querySelectorAll('[data-nav-cat-dropdown]')) as HTMLDetailsElement[];
    if (!dropdowns.length) return;

    const positionPanel = (dropdown: HTMLDetailsElement) => {
      const summary = dropdown.querySelector('summary') as HTMLElement | null;
      const panel = dropdown.querySelector('.nav-cat-panel') as HTMLElement | null;
      if (!summary || !panel) return;

      const summaryRect = summary.getBoundingClientRect();
      const navCats = document.getElementById('nav-cats') as HTMLElement | null;
      const navCatsContainer = navCats?.querySelector('.pe-container') as HTMLElement | null;
      const viewportWidth = window.innerWidth;
      const viewportHeight = window.innerHeight;
      const horizontalMargin = 12;
      const verticalGap = 8;
      const isDesktopTray = window.matchMedia('(min-width: 1024px)').matches;

      if (isDesktopTray && navCats && navCatsContainer) {
        const navRect = navCats.getBoundingClientRect();
        const containerRect = navCatsContainer.getBoundingClientRect();
        const trayTop = Math.round(navRect.bottom + 1);
        const trayLeft = Math.max(horizontalMargin, Math.round(containerRect.left));
        const trayWidth = Math.min(
          Math.round(containerRect.width),
          Math.round(viewportWidth - horizontalMargin * 2),
        );
        const trayMaxHeight = Math.max(220, Math.round(viewportHeight - trayTop - 20));

        panel.style.width = `${trayWidth}px`;
        panel.style.maxHeight = `${trayMaxHeight}px`;
        panel.style.left = `${trayLeft}px`;
        panel.style.top = `${trayTop}px`;
        return;
      }

      const preferredWidth = Math.min(380, Math.round(viewportWidth * 0.82));
      const clampedWidth = Math.max(230, Math.min(preferredWidth, viewportWidth - horizontalMargin * 2));
      panel.style.width = `${clampedWidth}px`;

      const panelRect = panel.getBoundingClientRect();
      const panelWidth = panelRect.width || clampedWidth;
      const panelHeight = panelRect.height || 320;

      let left = Math.round(summaryRect.left);
      if (left + panelWidth > viewportWidth - horizontalMargin) {
        left = Math.round(viewportWidth - horizontalMargin - panelWidth);
      }
      if (left < horizontalMargin) {
        left = horizontalMargin;
      }

      let top = Math.round(summaryRect.bottom + verticalGap);
      if (top + panelHeight > viewportHeight - horizontalMargin) {
        top = Math.max(horizontalMargin, Math.round(viewportHeight - horizontalMargin - panelHeight));
      }

      panel.style.left = `${left}px`;
      panel.style.top = `${top}px`;
    };

    const positionOpenPanels = () => {
      dropdowns.forEach((dropdown) => {
        if (!dropdown.open) return;
        positionPanel(dropdown);
      });
    };

    const closeOthers = (keep: HTMLDetailsElement) => {
      dropdowns.forEach((item) => {
        if (item !== keep) item.open = false;
      });
    };

    dropdowns.forEach((dropdown) => {
      if (dropdown.dataset.ready === '1') return;
      dropdown.dataset.ready = '1';
      dropdown.addEventListener('toggle', () => {
        if (dropdown.open) {
          closeOthers(dropdown);
          positionPanel(dropdown);
        }
      });
    });

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      const inside = target.closest('[data-nav-cat-dropdown]');
      if (inside) return;
      dropdowns.forEach((item) => { item.open = false; });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      dropdowns.forEach((item) => { item.open = false; });
    });

    window.addEventListener('resize', positionOpenPanels, { passive: true });
    window.addEventListener('scroll', positionOpenPanels, { passive: true });
  }

  /**
   * The header's own dress, nothing else. ThemeBootstrap owns what the theme is; this used to be
   * a fourth copy of that decision and it disagreed with the other three.
   */
  function dressHeaderFor(theme: string) {
    const header = document.getElementById('site-header');
    const moonIcon = document.getElementById('icon-moon');
    const sunIcon = document.getElementById('icon-sun');
    const light = theme === 'light';

    header?.classList.toggle('theme-light', light);
    moonIcon?.classList.toggle('hidden', light);
    sunIcon?.classList.toggle('hidden', !light);
  }

  function syncHeaderHeightVar() {
    const header = document.getElementById('site-header');
    if (!header) return;
    const height = Math.max(0, Math.round(header.getBoundingClientRect().height));
    document.documentElement.style.setProperty('--pe-site-header-height', `${height}px`);
  }

  function setCompactState(nextCompact: boolean) {
    const header = document.getElementById('site-header');
    if (!header) return;
    if (isCompact === nextCompact || transitionLocked) return;

    transitionLocked = true;
    if (transitionUnlockTimer !== undefined) {
      window.clearTimeout(transitionUnlockTimer);
    }

    isCompact = nextCompact;
    header.classList.toggle('logo-compact', nextCompact);
    requestAnimationFrame(syncHeaderHeightVar);
    transitionUnlockTimer = window.setTimeout(() => {
      transitionLocked = false;
      syncHeaderHeightVar();
    }, 420);
  }

  function applyLogoScrollState() {
    const header = document.getElementById('site-header');
    if (!header) return;
    const y = window.scrollY;
    const scrollingDown = y > lastScrollY + 1;
    const scrollingUp = y < lastScrollY - 1;

    if (!isCompact && scrollingDown && y >= COMPACT_ON_SCROLL_Y) {
      setCompactState(true);
      lastScrollY = y;
      return;
    }

    if (isCompact && scrollingUp && y <= EXPAND_ON_SCROLL_Y) {
      setCompactState(false);
    }

    lastScrollY = y;
  }

  dressHeaderFor(window.peTheme.current());
  lastScrollY = window.scrollY;
  applyLogoScrollState();
  initCategorySlider();
  initCategoryDropdowns();
  const header = document.getElementById('site-header');
  header?.classList.add('logo-intro');
  syncHeaderHeightVar();
  requestAnimationFrame(syncHeaderHeightVar);

  const hamburger = document.getElementById('nav-hamburger');
  if (hamburger) {
    hamburger.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('mobile-nav:open'));
      hamburger.setAttribute('aria-expanded', 'true');
    });
    window.addEventListener('mobile-nav:close', () => {
      hamburger.setAttribute('aria-expanded', 'false');
    });
  }

  document.getElementById('nav-search-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-search'));
  });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    dressHeaderFor(window.peTheme.toggle());
  });

  window.addEventListener('scroll', () => {
    applyLogoScrollState();
    syncHeaderHeightVar();
  }, { passive: true });
  window.addEventListener('resize', syncHeaderHeightVar, { passive: true });
  window.addEventListener('load', syncHeaderHeightVar, { passive: true });

  // Dispatch mega-menu events from hover on .mega-trigger elements
  document.querySelectorAll('.mega-trigger').forEach((trigger) => {
    const slug = (trigger as HTMLElement).dataset.slug;
    if (!slug) return;

    trigger.addEventListener('mouseenter', () => {
      window.dispatchEvent(new CustomEvent('mega-menu:open', { detail: { slug } }));
      trigger.setAttribute('aria-expanded', 'true');
    });

    trigger.addEventListener('mouseleave', () => {
      window.dispatchEvent(new CustomEvent('mega-menu:close'));
      trigger.setAttribute('aria-expanded', 'false');
    });

    // Click outside should also close
    trigger.addEventListener('click', () => {
      // Allow navigation — don't preventDefault
      window.dispatchEvent(new CustomEvent('mega-menu:close'));
    });
  });

  const megaTriggers = Array.from(document.querySelectorAll('.mega-trigger')) as HTMLElement[];
  let lastMegaTriggerSlug: string | null = null;
  let suppressedFocusOpenSlug: string | null = null;

  function syncMegaTriggerState(activeSlug: string | null) {
    megaTriggers.forEach((trigger) => {
      const triggerSlug = trigger.dataset.slug;
      trigger.setAttribute('aria-expanded', triggerSlug && triggerSlug === activeSlug ? 'true' : 'false');
    });
  }

  megaTriggers.forEach((trigger) => {
    const slug = trigger.dataset.slug;
    if (!slug) return;

    const openMegaMenu = () => {
      if (suppressedFocusOpenSlug === slug) {
        suppressedFocusOpenSlug = null;
        return;
      }
      lastMegaTriggerSlug = slug;
      window.dispatchEvent(new CustomEvent('mega-menu:open', { detail: { slug } }));
    };

    trigger.addEventListener('focus', openMegaMenu);
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === ' ') {
        event.preventDefault();
        lastMegaTriggerSlug = slug;
        window.dispatchEvent(new CustomEvent('mega-menu:open', { detail: { slug, focusFirst: true } }));
      }
      if (event.key === 'Escape') {
        window.dispatchEvent(new CustomEvent('mega-menu:close'));
      }
    });
  });

  window.addEventListener('mega-menu:state', (event) => {
    const activeSlug = (event as CustomEvent).detail?.activeSlug ?? null;
    syncMegaTriggerState(activeSlug);
  });

  window.addEventListener('mega-menu:closed', (event) => {
    syncMegaTriggerState(null);
    if (!(event as CustomEvent).detail?.restoreFocus || !lastMegaTriggerSlug) return;
    const trigger = document.querySelector(`.mega-trigger[data-slug="${lastMegaTriggerSlug}"]`) as HTMLElement | null;
    suppressedFocusOpenSlug = lastMegaTriggerSlug;
    trigger?.focus();
  });

  document.addEventListener('focusin', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;
    if (target.closest('.mega-trigger') || target.closest('.mega-tray')) return;
    window.dispatchEvent(new CustomEvent('mega-menu:close'));
  });

  // Update --header-height CSS var so tray positions correctly
  function updateHeaderHeight() {
    const header = document.getElementById('site-header');
    if (header) {
      document.documentElement.style.setProperty('--header-height', header.offsetHeight + 'px');
    }
  }
  updateHeaderHeight();
  window.addEventListener('resize', updateHeaderHeight);
  // Also update after scroll (header shrinks on scroll)
  window.addEventListener('scroll', updateHeaderHeight, { passive: true });
</script>

