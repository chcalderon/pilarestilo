---
interface Props {
  value: number;
  count?: number;
  size?: number;
}

const { value, count, size = 14 } = Astro.props;
const filled = Math.round(value);
---

<span class="inline-flex items-center gap-1.5">
  <span class="flex gap-0.5">
    {[1, 2, 3, 4, 5].map(i => (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width={size}
        height={size}
        viewBox="0 0 24 24"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"
        class={i <= filled ? 'fill-[#B76E79] stroke-[#B76E79]' : 'fill-none stroke-[#3A3A3A]/30'}
      >
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
    ))}
  </span>
  {count !== undefined && (
    <span class="text-[10px] text-[#3A3A3A]/50">({count})</span>
  )}
</span>
