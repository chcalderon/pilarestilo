---
import type { Locale } from '../i18n/index';

interface Props {
  priceAmount: number;
  locale?: Locale;
}

const { priceAmount, locale = 'es' } = Astro.props;

const fmt = (n: number) =>
  new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);

const cuotas = [
  { n: 3,  amount: Math.ceil(priceAmount / 3) },
  { n: 6,  amount: Math.ceil(priceAmount / 6) },
  { n: 12, amount: Math.ceil(priceAmount / 12) },
];
---

<div class="border border-[#EDE3D8] p-4 space-y-2">
  <p class="text-[10px] tracking-widest uppercase text-[#3A3A3A]/50 mb-3">
    {locale === 'es' ? 'Financiación sin interés' : 'Installment plans available'}
  </p>
  {cuotas.map(c => (
    <div class="flex items-baseline justify-between">
      <span class="font-['Cormorant_Garamond',serif] text-[#1A1A1A]">
        {c.n} {locale === 'es' ? `cuotas de` : `installments of`}
      </span>
      <span class="font-['Cormorant_Garamond',serif] text-[#B76E79] font-medium">
        {fmt(c.amount)}
      </span>
    </div>
  ))}
  <p class="text-[9px] tracking-wide text-[#3A3A3A]/40 pt-1">
    {locale === 'es' ? 'sin interés con tarjetas seleccionadas' : 'interest-free with selected cards'}
  </p>
</div>
