---
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import Icon from './Icon.astro';

export interface Props {
  locale: Locale;
  instagramUrl?: string | null;
  facebookUrl?: string | null;
}

const {
  locale,
  instagramUrl = 'https://instagram.com/pilarestilo',
  facebookUrl = 'https://facebook.com/pilarestilo',
} = Astro.props;

const links = {
  coleccion: [
    { labelEs: 'Novedades', labelEn: 'New arrivals', href: `/${locale}/products?sort=newest` },
    { labelEs: 'Invierno', labelEn: 'Winter', href: `/${locale}/products?category=invierno` },
    { labelEs: 'Verano', labelEn: 'Summer', href: `/${locale}/products?category=verano` },
    { labelEs: 'Zapatos', labelEn: 'Shoes', href: `/${locale}/products?category=zapatos` },
    { labelEs: 'Carteras', labelEn: 'Bags', href: `/${locale}/products?category=carteras` },
  ],
  info: [
    { labelEs: 'Sobre Pilar Estilo', labelEn: 'About us', href: `/${locale}/about` },
    { labelEs: 'Cómo vendemos', labelEn: 'How we sell', href: '/' + locale + '/how-we-sell' },
    { labelEs: 'Envíos y devoluciones', labelEn: 'Shipping & returns', href: `/${locale}/shipping-returns` },
    { labelEs: 'Contacto', labelEn: 'Contact', href: `/${locale}/contact` },
  ],
};
---

<footer class="bg-pe-black text-pe-white/60" aria-label="Site footer">
  <!-- Ornamental top rule -->
  <div class="h-px w-full bg-gradient-to-r from-transparent via-pe-gold/40 to-transparent"></div>

  <div class="pe-container py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand column -->
      <div class="lg:col-span-2 flex flex-col gap-5">
        <a href={`/${locale}/`} class="flex items-center gap-3 group w-fit">
          <img src="/logo-pe.svg" alt="Pilar Estilo" width="130" height="115"
               class="opacity-80 group-hover:opacity-100 transition-opacity duration-300 max-h-14 w-auto" />
          <div>
            <p class="font-sans text-[0.62rem] tracking-[0.32em] uppercase text-pe-white/50 group-hover:text-pe-rose-soft transition-colors duration-300">
              Pilar Estilo
            </p>
            <p class="pe-script text-pe-rose-soft text-xl leading-tight">
              Lujo con Propósito
            </p>
          </div>
        </a>
        <p class="font-sans text-[0.82rem] text-pe-white/40 leading-relaxed max-w-xs">
          {locale === 'es'
            ? 'Moda de lujo curada — piezas nuevas y de segunda mano de las marcas más deseadas del mundo.'
            : 'Curated luxury fashion — new and pre-loved pieces from the world\'s most desired brands.'}
        </p>

        <!-- Newsletter -->
        <form class="flex gap-2 mt-2" onsubmit="return false;">
          <input
            type="email"
            placeholder={locale === 'es' ? 'Tu email' : 'Your email'}
            class="flex-1 bg-pe-white/6 border border-pe-white/12 text-pe-white/70 placeholder-pe-white/25 px-3 py-2 text-[0.8rem] font-sans focus:outline-hidden focus:border-pe-rose/60 transition-colors duration-200"
            aria-label={locale === 'es' ? 'Correo electrónico para newsletter' : 'Newsletter email'}
          />
          <button
            type="submit"
            class="bg-pe-rose hover:bg-pe-rose-deep transition-colors duration-200 text-pe-offwhite px-3 py-2"
            aria-label={locale === 'es' ? 'Suscribirse' : 'Subscribe'}
          >
            <Icon name="send" size={14} />
          </button>
        </form>
      </div>

      <!-- Colección links -->
      <div>
        <h3 class="font-sans text-[0.65rem] tracking-[0.28em] uppercase text-pe-white/30 mb-5">
          {locale === 'es' ? 'Colección' : 'Collection'}
        </h3>
        <ul class="flex flex-col gap-3" role="list">
          {links.coleccion.map(l => (
            <li>
              <a
                href={l.href}
                class="font-sans text-[0.82rem] text-pe-white/50 hover:text-pe-rose-soft transition-colors duration-200"
              >
                {locale === 'es' ? l.labelEs : l.labelEn}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Info links + socials -->
      <div>
        <h3 class="font-sans text-[0.65rem] tracking-[0.28em] uppercase text-pe-white/30 mb-5">
          {locale === 'es' ? 'Información' : 'Information'}
        </h3>
        <ul class="flex flex-col gap-3 mb-8" role="list">
          {links.info.map(l => (
            <li>
              <a
                href={l.href}
                class="font-sans text-[0.82rem] text-pe-white/50 hover:text-pe-rose-soft transition-colors duration-200"
              >
                {locale === 'es' ? l.labelEs : l.labelEn}
              </a>
            </li>
          ))}
        </ul>

        <!-- Social icons -->
        <div class="flex gap-4">
          <a href={instagramUrl ?? '#'} target="_blank" rel="noopener noreferrer" class="text-pe-white/30 hover:text-pe-rose-soft transition-colors duration-200" aria-label="Instagram">
            <Icon name="instagram" size={17} strokeWidth={1.4} />
          </a>
          <a href={facebookUrl ?? '#'} target="_blank" rel="noopener noreferrer" class="text-pe-white/30 hover:text-pe-rose-soft transition-colors duration-200" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-pe-white/8 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="font-sans text-[0.72rem] text-pe-white/25 tracking-wide">
        {t('footer.rights', locale)}
      </p>
      <div class="chapter-mark text-[0.9rem] opacity-30">
        Lujo con Prop&oacute;sito
      </div>
    </div>
  </div>
</footer>


