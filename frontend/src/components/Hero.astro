---
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import Button from './Button.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section
  class="relative min-h-[96vh] flex flex-col items-center justify-center rose-mesh grain-overlay grain-strong overflow-hidden"
  aria-labelledby="hero-headline"
>
  <!-- Desktop fashion silhouettes fused into the background -->
  <div class="hero-model-layer pointer-events-none" aria-hidden="true">
    <div class="hero-model hero-model-left"></div>
    <div class="hero-model hero-model-right"></div>
    <div class="hero-model-center-veil"></div>
  </div>

  <!-- Ornamental thin rings (purely decorative) -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none" aria-hidden="true">
    <div class="w-[780px] h-[780px] rounded-full border hero-ring-1 absolute"></div>
    <div class="w-[560px] h-[560px] rounded-full border hero-ring-2 absolute"></div>
    <div class="w-[340px] h-[340px] rounded-full border hero-ring-3 absolute"></div>
  </div>

  <!-- Content -->
  <div class="pe-container relative z-10 text-center px-4 max-w-4xl">

    <!-- Eyebrow -->
    <p class="pe-eyebrow mb-5 fx-hero-eyebrow">
      {locale === 'es' ? 'Colección Curada' : 'Curated Collection'}
    </p>

    <!-- Headline in display serif -->
    <h1
      id="hero-headline"
      class="font-display text-pe-black font-light leading-[1.05] tracking-[-0.01em] mb-4 fx-hero-headline"
      style="font-size: clamp(3.2rem, 8vw, 7rem);"
    >
      {t('hero.headline', locale)}
    </h1>

    <!-- Cursive flourish -->
    <p
      class="pe-script text-pe-rose mb-10 fx-hero-script"
      style="font-size: clamp(2.2rem, 5vw, 3.8rem); line-height: 1.15; opacity: 0;"
    >
      Lujo con Prop&oacute;sito
    </p>

    <!-- Rose-gold thin divider -->
    <div class="flex items-center justify-center gap-3 mb-10 fx-hero-cta" style="opacity:0;">
      <div class="h-px w-20 bg-gradient-to-r from-transparent to-pe-rose/50"></div>
      <span class="w-1 h-1 rounded-full bg-pe-rose/60 block"></span>
      <div class="h-px w-20 bg-gradient-to-l from-transparent to-pe-rose/50"></div>
    </div>

    <!-- CTA -->
    <div class="flex flex-wrap items-center justify-center gap-4 fx-hero-cta" style="opacity:0;">
      <Button href={`/${locale}/products`} variant="primary" leadingIcon="arrow-right">
        {t('hero.cta', locale)}
      </Button>
      <Button href={`/${locale}/products?category=zapatos`} variant="outline">
        {locale === 'es' ? 'Ver zapatos' : 'See shoes'}
      </Button>
    </div>

    <!-- Subtle slogan below CTAs -->
    <p
      class="font-sans text-pe-charcoal/45 text-[0.78rem] tracking-[0.25em] uppercase mt-14 fx-hero-cta"
      style="opacity:0;"
    >
      {t('hero.slogan', locale)}
    </p>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 fx-hero-cta"
    style="opacity:0;"
    aria-hidden="true"
  >
    <span class="font-sans text-[0.6rem] tracking-[0.3em] uppercase text-pe-charcoal/30">
      {locale === 'es' ? 'Explorar' : 'Explore'}
    </span>
    <div class="w-px h-8 bg-gradient-to-b from-pe-rose/50 to-transparent animate-[rose-shimmer_3s_ease-in-out_infinite]"></div>
  </div>
</section>

<style>
  .hero-model-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
  }

  .hero-model,
  .hero-model-center-veil {
    position: absolute;
    inset: 0 auto 0 auto;
    pointer-events: none;
  }

  .hero-model {
    top: auto;
    bottom: -2vh;
    width: clamp(22rem, 29vw, 31rem);
    height: min(84vh, 54rem);
    background-size: contain;
    background-repeat: no-repeat;
    filter: saturate(1.02) contrast(1.08) brightness(0.95) drop-shadow(0 20px 28px rgba(18, 14, 20, 0.28));
    mix-blend-mode: normal;
    opacity: 0.7;
    transform: translateY(10px) scale(1.02);
  }

  .hero-model-left {
    left: max(-5vw, -3rem);
    background-image: url('/api/media/hero-models/hero-left.png');
    background-position: center bottom;
    -webkit-mask-image:
      linear-gradient(to right, black 0%, black 60%, rgba(0, 0, 0, 0.35) 86%, transparent 100%),
      linear-gradient(to top, black 0%, black 72%, rgba(0, 0, 0, 0.44) 90%, transparent 100%);
    mask-image:
      linear-gradient(to right, black 0%, black 60%, rgba(0, 0, 0, 0.35) 86%, transparent 100%),
      linear-gradient(to top, black 0%, black 72%, rgba(0, 0, 0, 0.44) 90%, transparent 100%);
  }

  .hero-model-right {
    right: max(-5vw, -3rem);
    background-image: url('/api/media/hero-models/hero-right.png');
    background-position: center bottom;
    -webkit-mask-image:
      linear-gradient(to left, black 0%, black 60%, rgba(0, 0, 0, 0.35) 86%, transparent 100%),
      linear-gradient(to top, black 0%, black 72%, rgba(0, 0, 0, 0.44) 90%, transparent 100%);
    mask-image:
      linear-gradient(to left, black 0%, black 60%, rgba(0, 0, 0, 0.35) 86%, transparent 100%),
      linear-gradient(to top, black 0%, black 72%, rgba(0, 0, 0, 0.44) 90%, transparent 100%);
  }

  .hero-model-center-veil {
    left: 50%;
    transform: translateX(-50%);
    width: min(64vw, 58rem);
    background:
      radial-gradient(circle at 50% 44%, rgba(18, 14, 20, 0.34) 0%, rgba(18, 14, 20, 0.14) 42%, rgba(18, 14, 20, 0) 84%);
  }

  @media (min-width: 1280px) {
    .hero-model-layer {
      opacity: 1;
      animation: hero-model-fade 1s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: 0.12s;
    }

    .hero-model-left {
      animation: hero-model-left-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: 0.2s;
    }

    .hero-model-right {
      animation: hero-model-right-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: 0.24s;
    }
  }

  @media (max-width: 1279px) {
    .hero-model-layer {
      display: block;
      opacity: 0.8;
    }

    .hero-model {
      width: clamp(14rem, 34vw, 21rem);
      height: min(62vh, 34rem);
      opacity: 0.46;
      filter: saturate(0.98) contrast(1.04) brightness(0.88) drop-shadow(0 14px 20px rgba(18, 14, 20, 0.2));
      transform: translateY(0) scale(1);
    }

    .hero-model-left {
      left: clamp(-9rem, -10vw, -3rem);
      background-position: left bottom;
    }

    .hero-model-right {
      right: clamp(-9rem, -10vw, -3rem);
      background-position: right bottom;
    }

    .hero-model-center-veil {
      width: min(70vw, 48rem);
      background:
        radial-gradient(circle at 50% 46%, rgba(18, 14, 20, 0.42) 0%, rgba(18, 14, 20, 0.2) 48%, rgba(18, 14, 20, 0) 86%);
    }
  }

  @media (max-width: 900px) {
    .hero-model {
      width: clamp(11.5rem, 38vw, 17rem);
      height: min(54vh, 28rem);
      opacity: 0.4;
      filter: saturate(0.95) contrast(1.03) brightness(0.86) drop-shadow(0 10px 14px rgba(18, 14, 20, 0.16));
    }

    .hero-model-left {
      left: clamp(-5.5rem, -9vw, -2.5rem);
      background-position: center bottom;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .hero-model-right {
      right: clamp(-5.5rem, -9vw, -2.5rem);
      background-position: center bottom;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .hero-model-center-veil {
      width: min(76vw, 34rem);
      background:
        radial-gradient(circle at 50% 48%, rgba(18, 14, 20, 0.42) 0%, rgba(18, 14, 20, 0.2) 44%, rgba(18, 14, 20, 0) 84%);
    }
  }

  @media (max-width: 640px) {
    .hero-model-layer {
      opacity: 0.75;
    }

    .hero-model {
      width: clamp(9.5rem, 41vw, 13rem);
      height: min(46vh, 22rem);
      opacity: 0.32;
      bottom: 2vh;
    }

    .hero-model-left {
      left: -14vw;
    }

    .hero-model-right {
      right: -14vw;
    }

    .hero-model-center-veil {
      width: min(82vw, 24rem);
      background:
        radial-gradient(circle at 50% 50%, rgba(18, 14, 20, 0.52) 0%, rgba(18, 14, 20, 0.3) 42%, rgba(18, 14, 20, 0) 82%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-model-layer,
    .hero-model-left,
    .hero-model-right {
      animation: none !important;
    }
  }

  html[data-theme='light'] .hero-model {
    opacity: 0.58;
    filter: saturate(0.95) contrast(1.04) brightness(0.92) drop-shadow(0 18px 24px rgba(18, 14, 20, 0.22));
  }

  @keyframes hero-model-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes hero-model-left-in {
    from { opacity: 0; transform: translate(-14px, 26px) scale(1.03); }
    to { opacity: 0.7; transform: translateY(0) scale(1); }
  }

  @keyframes hero-model-right-in {
    from { opacity: 0; transform: translate(14px, 26px) scale(1.03); }
    to { opacity: 0.7; transform: translateY(0) scale(1); }
  }
</style>
