---
import type { ProductDto } from '../lib/api';
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import AddToCartButton from '../islands/AddToCartButton';
import QuickRateStars from '../islands/reviews/QuickRateStars';
import WishlistButton from '../islands/wishlist/WishlistButton';
import RatingStars from './RatingStars.astro';
import { summarizeProductVariantSecondaryValues } from '../lib/productVariants';
import { getProductVariantSchema, getSecondaryAttribute } from '../lib/variantSchema';

export interface Props {
  product: ProductDto;
  locale: Locale;
  priority?: boolean;
  token?: string;
}

const { product, locale, priority = false, token } = Astro.props;

/*
 * Only send the customer to the product page when there is an actual choice to make. Twelve of
 * the seventeen products here are a single Base/UNICO row, and asking someone to pick from a
 * list of one is friction, not clarity — the card adds those directly, naming the one variant so
 * the line is complete.
 *
 * <p>With several variants the card has no picker and cannot guess, and inventory-service refuses
 * any reservation that names no colour and size. Offering a plain add button there is what put
 * lines in the cart that could never be ordered.
 */
const productVariants = product.variants ?? [];
const needsVariantChoice = productVariants.length > 1;
const onlyVariant = productVariants.length === 1 ? productVariants[0] : null;

const priceFormatted = new Intl.NumberFormat('es-CL', {
  style: 'currency',
  currency: product.price.currency,
  maximumFractionDigits: 0,
}).format(product.price.amount);

const hasDiscount =
  !!product.listPrice
  && product.listPrice.currency === product.price.currency
  && product.listPrice.amount > product.price.amount;

const listPriceFormatted = hasDiscount
  ? new Intl.NumberFormat('es-CL', {
      style: 'currency',
      currency: product.listPrice!.currency,
      maximumFractionDigits: 0,
    }).format(product.listPrice!.amount)
  : null;

const discountPct = hasDiscount
  ? Math.round((1 - product.price.amount / product.listPrice!.amount) * 100)
  : null;

const conditionLabel =
  product.condition === 'NEW'
    ? t('product.condition.new', locale)
    : t('product.condition.used', locale);

const isNew = product.condition === 'NEW';
const variantSchema = getProductVariantSchema(product);
const secondaryAttribute = getSecondaryAttribute(variantSchema);
const sizesSummary = summarizeProductVariantSecondaryValues(product);
---

<article class="group relative flex flex-col bg-pe-white overflow-hidden fx-lift cursor-rose" aria-label={product.name}>
  <div class="rose-rule"></div>

  <a href={`/${locale}/products/${product.id}`} class="block overflow-hidden aspect-[3/4] bg-pe-cream" tabindex="-1" aria-hidden="true">
    <img
      src={product.imageUrl}
      alt={product.name}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
      width="300"
      height="400"
    />

    <span
      class:list={[
        'absolute top-3 left-3 font-sans text-[0.58rem] tracking-[0.22em] uppercase px-2.5 py-1',
        isNew ? 'bg-pe-black text-pe-offwhite' : 'bg-pe-rose-soft text-black border border-pe-rose/45',
      ]}
    >
      {conditionLabel}
    </span>

  </a>

  <div class="absolute top-3 right-3 z-10 opacity-100 md:opacity-0 md:group-hover:opacity-100 translate-y-0 md:translate-y-1 md:group-hover:translate-y-0 transition-all duration-300">
    <WishlistButton
      client:visible
      productId={product.id}
      token={token}
      className="p-1.5 bg-pe-offwhite/80 backdrop-blur-sm text-pe-charcoal/50 hover:text-pe-rose"
    />
  </div>

  <div class="flex flex-col flex-1 px-4 pt-3 pb-4 gap-1.5">
    <span class="font-sans text-[0.62rem] tracking-[0.28em] uppercase text-pe-rose font-medium">{product.brand}</span>

    <a href={`/${locale}/products/${product.id}`} class="hover:text-pe-rose-deep transition-colors duration-200">
      <h3 class="font-display text-pe-black text-[1.05rem] font-normal leading-snug line-clamp-2">{product.name}</h3>
    </a>
    {sizesSummary && (
      <p class="font-sans text-[0.62rem] tracking-[0.12em] uppercase text-pe-charcoal/45">
        {secondaryAttribute.label}: {sizesSummary}
      </p>
    )}

    <div class="min-h-[1.2rem]">
      <RatingStars value={product.avgRating ?? 0} size={12} />
    </div>

    {token && (
      <div>
        <QuickRateStars client:idle productId={product.id} token={token} locale={locale} />
      </div>
    )}

    <div class="flex items-center justify-between mt-auto pt-2">
      <div class="flex flex-col leading-tight">
        {hasDiscount && <span class="font-sans text-[0.68rem] text-pe-charcoal/40 line-through">{listPriceFormatted}</span>}
        <div class="flex items-center gap-1.5">
          <span class="font-display text-pe-black text-lg font-medium tracking-tight">{priceFormatted}</span>
          {discountPct !== null && <span class="font-sans text-[0.6rem] tracking-[0.08em] uppercase text-emerald-700">-{discountPct}%</span>}
        </div>
      </div>
      {product.stock === 1 && (
        <span class="font-sans text-[0.6rem] tracking-wider uppercase text-pe-rose-deep/70">
          {locale === 'es' ? 'Ultimo' : 'Last one'}
        </span>
      )}
    </div>

    <div class="mt-2 overflow-hidden max-h-0 group-hover:max-h-16 transition-all duration-400 ease-in-out">
      {needsVariantChoice ? (
        <a
          href={`/${locale}/products/${product.id}`}
          class="w-full inline-flex items-center justify-center min-h-11 px-4 border border-pe-black/20
            font-sans text-[0.68rem] tracking-[0.16em] uppercase text-pe-charcoal
            hover:border-pe-black hover:text-pe-black transition-colors
            focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pe-rose"
        >
          {locale === 'es' ? 'Elegir talla' : 'Choose size'}
        </a>
      ) : (
        <AddToCartButton
          client:visible
          productId={product.id}
          name={product.name}
          brand={product.brand}
          price={product.price}
          imageUrl={product.imageUrl}
          condition={product.condition}
          stock={product.stock}
          locale={locale}
          variantColor={onlyVariant?.color}
          variantSize={onlyVariant?.size}
        />
      )}
    </div>
  </div>

  <div class="rose-rule"></div>
</article>
