---
export interface Props {
  imageUrl?: string;
  title?: string;
  subtitle?: string;
  link?: string;
  locale: string;
}
const { imageUrl, title, subtitle, link, locale } = Astro.props;
---
{imageUrl && (
  <div class="nav-banner flex flex-col overflow-hidden rounded-xs">
    <a href={link || '#'} class="group relative block overflow-hidden">
      <img
        src={imageUrl}
        alt={title || ''}
        loading="lazy"
        class="nav-banner-img w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        style="aspect-ratio: 3/4; max-height: 280px;"
      />
      {(title || subtitle) && (
        <div class="absolute inset-0 flex flex-col justify-end p-4 bg-gradient-to-t from-black/60 via-black/10 to-transparent">
          {title && <p class="font-display text-pe-cream text-lg leading-tight">{title}</p>}
          {subtitle && <p class="font-sans text-pe-cream/80 text-[0.65rem] tracking-widest uppercase mt-1">{subtitle}</p>}
        </div>
      )}
    </a>
  </div>
)}
