---
import type { NavigationChildDto } from '../../lib/api';
export interface Props {
  children: NavigationChildDto[];
  locale: string;
}
const { children, locale } = Astro.props;
---
<ul class="nav-mega-col flex flex-col gap-1" role="list">
  {children.map((child) => (
    <li>
      <a
        href={`/${locale}/categories/${child.slug}`}
        class="nav-mega-link group flex items-center gap-2 py-1 text-pe-on-dark hover:text-pe-rose-soft transition-colors duration-150"
        aria-current={false}
      >
        <span class="font-sans text-[0.7rem] tracking-[0.15em] uppercase leading-snug">{child.name}</span>
      </a>
      {child.children?.length > 0 && (
        <ul class="ml-3 mt-0.5 flex flex-col gap-0.5" role="list">
          {child.children.map((grandchild) => (
            <li>
              <a
                href={`/${locale}/categories/${grandchild.slug}`}
                class="block font-sans text-[0.63rem] tracking-[0.12em] uppercase text-pe-on-dark-muted hover:text-pe-rose-soft/80 transition-colors duration-150 py-0.5"
              >
                {grandchild.name}
              </a>
            </li>
          ))}
        </ul>
      )}
    </li>
  ))}
</ul>
