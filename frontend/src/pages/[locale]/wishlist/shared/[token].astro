---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SharedWishlistPage from '../../../../islands/wishlist/SharedWishlistPage';
import { type Locale, SUPPORTED_LOCALES } from '../../../../i18n/index';

const { locale, token } = Astro.params as { locale: Locale; token: string };

if (!SUPPORTED_LOCALES.includes(locale)) {
  return Astro.redirect('/es/wishlist');
}
---

<BaseLayout
  title={locale === 'es' ? 'Favoritos Compartidos' : 'Shared Wishlist'}
  locale={locale}
>
  <section class="max-w-7xl mx-auto px-6 py-12">
    <header class="mb-10">
      <p class="text-[10px] tracking-[0.3em] uppercase text-[#B76E79] mb-2">
        {locale === 'es' ? 'Wishlist compartido' : 'Shared wishlist'}
      </p>
      <h1 class="font-['Cormorant_Garamond',serif] text-4xl font-light text-[#1A1A1A]">
        {locale === 'es' ? 'Favoritos seleccionados' : 'Curated favorites'}
      </h1>
    </header>
    <SharedWishlistPage client:load locale={locale} shareToken={token} />
  </section>
</BaseLayout>
