---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { SUPPORTED_LOCALES, type Locale } from '../../i18n/index';

const { locale } = Astro.params as { locale: Locale };

if (!SUPPORTED_LOCALES.includes(locale)) {
  return Astro.redirect('/es/about');
}

const isEs = locale === 'es';

const values = isEs
  ? [
      {
        title: 'Curaduria real',
        description:
          'Seleccionamos piezas con criterio editorial: estado, autenticidad y vigencia estetica antes de entrar al catalogo.',
      },
      {
        title: 'Lujo consciente',
        description:
          'Combinamos prendas nuevas y pre-loved para extender el ciclo de vida de la moda de lujo sin perder sofisticacion.',
      },
      {
        title: 'Experiencia cercana',
        description:
          'Asesoria simple, pagos claros y acompanamiento postventa para que comprar lujo se sienta facil y confiable.',
      },
    ]
  : [
      {
        title: 'Real curation',
        description:
          'Every piece is selected with editorial criteria: condition, authenticity, and lasting aesthetic value.',
      },
      {
        title: 'Conscious luxury',
        description:
          'We mix new and pre-loved items to extend the life cycle of luxury fashion without losing style.',
      },
      {
        title: 'Human experience',
        description:
          'Simple guidance, clear payments, and post-sale support so luxury shopping feels easy and trustworthy.',
      },
    ];

const processSteps = isEs
  ? [
      { title: 'Seleccion', description: 'Revisamos calidad, estado y potencial de cada pieza antes de publicarla.' },
      { title: 'Presentacion', description: 'Creamos fichas claras con fotos, descripcion y contexto de uso real.' },
      { title: 'Acompanamiento', description: 'Te acompanamos desde la compra hasta la entrega con soporte directo.' },
    ]
  : [
      { title: 'Selection', description: 'We validate quality, condition, and brand fit before publishing any item.' },
      { title: 'Presentation', description: 'We build clear listings with detailed photos and practical context.' },
      { title: 'Support', description: 'We stay with you from checkout to delivery with direct customer assistance.' },
    ];
---

<BaseLayout
  title={isEs ? 'Sobre Pilar Estilo' : 'About Pilar Estilo'}
  description={isEs ? 'Conoce la historia y propuesta de valor de Pilar Estilo.' : 'Learn the story and value proposition behind Pilar Estilo.'}
  locale={locale}
>
  <div class="bg-pe-offwhite">
    <section class="relative overflow-hidden border-b border-pe-black/10 bg-pe-cream">
      <div class="absolute -top-40 left-1/2 h-[38rem] w-[38rem] -translate-x-1/2 rounded-full border border-pe-rose/20" aria-hidden="true"></div>
      <div class="absolute -top-24 left-1/2 h-[26rem] w-[26rem] -translate-x-1/2 rounded-full border border-pe-gold/20" aria-hidden="true"></div>
      <div class="pe-container py-16 md:py-20 text-center relative z-[1]">
        <p class="pe-eyebrow text-pe-rose-ink mb-4">
          {isEs ? 'Sobre la marca' : 'About the brand'}
        </p>
        <h1 class="font-display text-pe-black text-4xl md:text-6xl font-light tracking-tight">
          {isEs ? 'Sobre Pilar Estilo' : 'About Pilar Estilo'}
        </h1>
        <p class="mt-6 mx-auto max-w-3xl font-sans text-sm md:text-base text-pe-charcoal leading-relaxed">
          {isEs
            ? 'Pilar Estilo nace para acercar la moda de lujo a una experiencia mas humana: curada, transparente y con mirada sostenible.'
            : 'Pilar Estilo was created to bring luxury fashion into a more human experience: curated, transparent, and sustainability-minded.'}
        </p>
      </div>
    </section>

    <section class="py-14 md:py-20">
      <div class="pe-container grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-10 items-stretch">
        <article class="bg-pe-white border border-pe-black/10 p-7 md:p-10 flex flex-col justify-center">
          <p class="chapter-mark mb-4">
            {isEs ? 'Nuestra Historia' : 'Our Story'}
          </p>
          <h2 class="font-display text-3xl md:text-4xl text-pe-black font-light mb-5">
            {isEs ? 'Lujo con proposito, no solo tendencia' : 'Luxury with purpose, beyond trends'}
          </h2>
          <p class="font-sans text-sm text-pe-charcoal leading-relaxed mb-4">
            {isEs
              ? 'Partimos con una idea simple: cada prenda premium merece una segunda oportunidad cuando su calidad lo permite. Hoy combinamos piezas nuevas y pre-loved para construir un catalogo con identidad.'
              : 'We started with a simple idea: premium garments deserve a second life when quality allows it. Today we blend new and pre-loved pieces to build a catalog with identity.'}
          </p>
          <p class="font-sans text-sm text-pe-charcoal leading-relaxed">
            {isEs
              ? 'Trabajamos con una curaduria exigente y una experiencia de compra clara, para que elegir lujo sea tambien una decision inteligente.'
              : 'We work with strict curation and clear purchase flows, so choosing luxury also feels like a smart decision.'}
          </p>
        </article>

        <figure class="relative overflow-hidden border border-pe-black/10 min-h-[320px] md:min-h-[420px]">
          <img
            src="/api/media/products/product-011.jpg"
            alt={isEs ? 'Editorial Pilar Estilo' : 'Pilar Estilo editorial'}
            class="h-full w-full object-cover"
            loading="lazy"
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-pe-black/70 to-transparent p-5">
            <p class="font-sans text-[0.72rem] tracking-[0.2em] uppercase text-pe-rose-soft mb-1">
              Pilar Estilo
            </p>
            <p class="font-display text-pe-on-dark text-xl font-light">
              {isEs ? 'Curaduria de lujo para cada historia' : 'Luxury curation for every story'}
            </p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="pb-14 md:pb-20">
      <div class="pe-container">
        <h2 class="font-display text-3xl md:text-4xl text-pe-black font-light mb-6 md:mb-8">
          {isEs ? 'Lo que nos define' : 'What defines us'}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
          {values.map((value) => (
            <article class="bg-pe-white border border-pe-black/10 p-6 md:p-7">
              <h3 class="font-display text-2xl text-pe-black font-light mb-3">{value.title}</h3>
              <p class="font-sans text-sm text-pe-charcoal leading-relaxed">{value.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-pe-black py-14 md:py-16">
      <div class="pe-container">
        <h2 class="font-display text-3xl md:text-4xl text-pe-on-dark font-light mb-8">
          {isEs ? 'Como trabajamos' : 'How we work'}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
          {processSteps.map((step, index) => (
            <article class="border border-pe-white/15 p-6 md:p-7 bg-pe-white/5">
              <p class="font-sans text-[0.68rem] tracking-[0.2em] uppercase text-pe-rose-soft mb-3">
                {isEs ? `Paso ${index + 1}` : `Step ${index + 1}`}
              </p>
              <h3 class="font-display text-2xl text-pe-on-dark font-light mb-2">{step.title}</h3>
              <p class="font-sans text-sm text-pe-on-dark-muted leading-relaxed">{step.description}</p>
            </article>
          ))}
        </div>
        <div class="mt-10">
          <Button href={`/${locale}/products`} variant="primary" trailingIcon="arrow-right">
            {isEs ? 'Ver coleccion' : 'View collection'}
          </Button>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
