---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AccountPage from '../../../islands/auth/AccountPage';
import { type Locale, SUPPORTED_LOCALES } from '../../../i18n/index';

const { locale } = Astro.params as { locale: Locale };
if (!SUPPORTED_LOCALES.includes(locale)) return Astro.redirect('/es/account');
---

<BaseLayout title={locale === 'es' ? 'Mi cuenta' : 'My account'} locale={locale} noindex>
  <AccountPage client:load locale={locale} />
</BaseLayout>
