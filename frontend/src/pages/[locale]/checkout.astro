---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CheckoutPage from '../../islands/checkout/CheckoutPage';
import { type Locale, SUPPORTED_LOCALES } from '../../i18n/index';

const { locale } = Astro.params as { locale: Locale };

if (!SUPPORTED_LOCALES.includes(locale)) {
  return Astro.redirect('/es/checkout');
}

// The session gate lives in src/middleware.ts: reaching this file means there is a token.
---

<BaseLayout title={locale === 'es' ? 'Finalizar compra' : 'Checkout'} locale={locale}>
  <CheckoutPage client:load locale={locale} />
</BaseLayout>
