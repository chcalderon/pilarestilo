---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WishlistPage from '../../islands/wishlist/WishlistPage';
import { type Locale, SUPPORTED_LOCALES, t } from '../../i18n/index';

const { locale } = Astro.params as { locale: Locale };

if (!SUPPORTED_LOCALES.includes(locale)) {
  return Astro.redirect('/es/wishlist');
}

const token = Astro.cookies.get('pe_token')?.value;
---

<BaseLayout title={locale === 'es' ? 'Mis Favoritos' : 'My Wishlist'} locale={locale}>
  <section class="max-w-7xl mx-auto px-6 py-12">
    <header class="mb-10">
      <p class="text-[10px] tracking-[0.3em] uppercase text-[#B76E79] mb-2">
        {locale === 'es' ? 'Mi cuenta' : 'My account'}
      </p>
      <h1 class="font-['Cormorant_Garamond',serif] text-4xl font-light text-[#1A1A1A]">
        {locale === 'es' ? 'Lista de Favoritos' : 'Wishlist'}
      </h1>
    </header>
    <WishlistPage client:load locale={locale} token={token} />
  </section>
</BaseLayout>
