---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Button from '../../../components/Button.astro';
import Icon from '../../../components/Icon.astro';
import CategoryTreeNav from '../../../components/CategoryTreeNav.astro';
import { type Locale, SUPPORTED_LOCALES, t } from '../../../i18n/index';
import { getProducts, getCategoryTree, type CategoryTreeNode, type ProductFilter, FIXTURE_PRODUCTS } from '../../../lib/api';

const { locale } = Astro.params as { locale: Locale };

if (!SUPPORTED_LOCALES.includes(locale)) {
  return Astro.redirect('/es/products');
}

const url = Astro.url;
const condition = url.searchParams.get('condition') as ProductFilter['condition'] | null;
const brand = url.searchParams.get('brand') ?? undefined;
const category = url.searchParams.get('category') ?? undefined;
const minPrice = url.searchParams.has('minPrice') ? Number(url.searchParams.get('minPrice')) : undefined;
const maxPrice = url.searchParams.has('maxPrice') ? Number(url.searchParams.get('maxPrice')) : undefined;
const rawPage = url.searchParams.get('page');
const parsedPage = rawPage !== null ? Number(rawPage) : 0;
const page = Number.isFinite(parsedPage) && parsedPage >= 0 ? Math.floor(parsedPage) : 0;
const PAGE_SIZE = 8;

const filter: ProductFilter = {
  ...(condition ? { condition } : {}),
  ...(brand ? { brand } : {}),
  ...(category ? { category } : {}),
  ...(minPrice !== undefined ? { minPrice } : {}),
  ...(maxPrice !== undefined ? { maxPrice } : {}),
  active: true,
  inStock: true,
  page,
  size: PAGE_SIZE,
};

let productsPage = {
  content: FIXTURE_PRODUCTS,
  totalElements: FIXTURE_PRODUCTS.length,
  totalPages: 1,
  size: FIXTURE_PRODUCTS.length,
  number: 0,
};
try {
  productsPage = await getProducts(filter);
} catch {
  // fallback
}
const token = Astro.cookies.get('pe_token')?.value;

let categoryTree: CategoryTreeNode[] = [];
try {
  categoryTree = (await getCategoryTree()).filter((node) => node.active);
} catch {
  // fallback to empty
}

function findNodeAndPath(
  nodes: CategoryTreeNode[],
  targetSlug: string,
  path: string[] = [],
): { node: CategoryTreeNode; path: string[] } | null {
  for (const node of nodes) {
    const currentPath = [...path, node.slug];
    if (node.slug === targetSlug) {
      return { node, path: currentPath };
    }
    if (node.children?.length) {
      const result = findNodeAndPath(node.children.filter((child) => child.active), targetSlug, currentPath);
      if (result) return result;
    }
  }
  return null;
}

const categoryMatch = category ? findNodeAndPath(categoryTree, category) : null;
const currentCategory = categoryMatch?.node ?? null;
const openCategorySlugs = categoryMatch?.path ?? [];

const activeFilters: { label: string; clearKey: string }[] = [];
if (condition) activeFilters.push({ label: condition === 'NEW' ? t('product.condition.new', locale) : t('product.condition.used', locale), clearKey: 'condition' });
if (brand) activeFilters.push({ label: brand, clearKey: 'brand' });
if (category) {
  activeFilters.push({
    label: currentCategory
      ? (locale === 'es' ? currentCategory.nameEs : (currentCategory.nameEn || currentCategory.nameEs))
      : category,
    clearKey: 'category',
  });
}

const clearUrl = `/${locale}/products`;

---

<BaseLayout title={t('nav.products', locale)} locale={locale}>
  <div class="bg-pe-offwhite min-h-screen">

    <!-- Page header band -->
    <div class="relative overflow-hidden border-b border-[var(--pe-border)]" style="background-color: var(--pe-surface-soft)">
      {currentCategory?.imageUrl && (
        <img
          src={currentCategory.imageUrl}
          alt={locale === 'es' ? currentCategory.nameEs : (currentCategory.nameEn || currentCategory.nameEs)}
          class="absolute inset-0 w-full h-full object-cover opacity-15"
          loading="eager"
        />
      )}
      <div class="relative pe-container py-10">
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 font-sans text-[0.68rem] tracking-[0.18em] uppercase text-pe-muted mb-3" aria-label="Breadcrumb">
          <a href={`/${locale}/`} class="hover:text-pe-rose-ink transition-colors duration-200">
            {locale === 'es' ? 'Inicio' : 'Home'}
          </a>
          <span aria-hidden="true"><Icon name="chevron-right" size={10} /></span>
          {currentCategory ? (
            <>
              <a href={`/${locale}/products`} class="hover:text-pe-rose-ink transition-colors duration-200">
                {locale === 'es' ? 'Productos' : 'Products'}
              </a>
              <span aria-hidden="true"><Icon name="chevron-right" size={10} /></span>
              <span class="text-pe-muted" aria-current="page">
                {locale === 'es' ? currentCategory.nameEs : (currentCategory.nameEn || currentCategory.nameEs)}
              </span>
            </>
          ) : (
            <span class="text-pe-muted" aria-current="page">
              {locale === 'es' ? 'Todos los productos' : 'All products'}
            </span>
          )}
        </nav>
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2">
          <h1 class="font-display text-pe-black text-3xl md:text-4xl font-light">
            {currentCategory
              ? (locale === 'es' ? currentCategory.nameEs : (currentCategory.nameEn || currentCategory.nameEs))
              : (locale === 'es' ? 'Colección' : 'Collection')}
          </h1>
          <p class="font-sans text-[0.78rem] text-pe-muted">
            {productsPage.totalElements} {locale === 'es' ? 'piezas' : 'pieces'}
          </p>
        </div>
      </div>
    </div>

    <div class="pe-container py-8">
      <div class="flex flex-col lg:flex-row gap-8">

        <!-- Sidebar filter rail -->
        <aside class="lg:w-52 shrink-0" aria-label={locale === 'es' ? 'Filtros' : 'Filters'}>
          <form method="get" class="flex flex-col gap-6">
            <!-- Categories -->
            <div>
              <div class="mb-3 flex items-center justify-between gap-2">
                <h3 class="pe-eyebrow">
                  {locale === 'es' ? 'Categorías' : 'Categories'}
                </h3>
                <button
                  type="button"
                  id="products-cat-tree-toggle"
                  class="inline-flex items-center justify-center w-6 h-6 border border-pe-black/15 text-pe-muted hover:text-pe-rose-ink hover:border-pe-rose/40 transition-colors"
                  aria-expanded="true"
                  aria-label={locale === 'es' ? 'Contraer categorías' : 'Collapse categories'}
                  data-label-expand={locale === 'es' ? 'Expandir categorías' : 'Expand categories'}
                  data-label-collapse={locale === 'es' ? 'Contraer categorías' : 'Collapse categories'}
                  title={locale === 'es' ? 'Contraer categorías' : 'Collapse categories'}
                >
                  <span data-icon aria-hidden="true">▾</span>
                </button>
              </div>
              <ul class="flex flex-col gap-1" role="list">
                <li>
                  <a
                    href={`/${locale}/products${condition ? `?condition=${condition}` : ''}${brand ? `${condition ? '&' : '?'}brand=${brand}` : ''}`}
                    class:list={[
                      'block font-sans text-[0.78rem] py-1 hover:text-pe-rose-ink transition-colors duration-200',
                      !category ? 'text-pe-rose-ink font-medium' : 'text-pe-muted',
                    ]}
                  >
                    {locale === 'es' ? 'Todo' : 'All'}
                  </a>
                </li>
                <li class="pt-1">
                  <CategoryTreeNav
                    nodes={categoryTree}
                    locale={locale}
                    routeMode="products"
                    viewMode="sidebar"
                    selectedSlug={category ?? undefined}
                    openSlugs={openCategorySlugs}
                    maxDepth={3}
                    defaultOpenAll={true}
                    condition={condition ?? undefined}
                    brand={brand}
                  />
                </li>
              </ul>
            </div>

            <!-- Condition toggle -->
            <div>
              <h3 class="pe-eyebrow mb-3">
                {locale === 'es' ? 'Condición' : 'Condition'}
              </h3>
              <div class="flex flex-col gap-1.5">
                {(['NEW', 'USED'] as const).map(c => {
                  const isActive = condition === c;
                  const newUrl = isActive
                    ? `/${locale}/products${category ? `?category=${category}` : ''}${brand ? `${category ? '&' : '?'}brand=${brand}` : ''}`
                    : `/${locale}/products?condition=${c}${category ? `&category=${category}` : ''}${brand ? `&brand=${brand}` : ''}`;
                  return (
                    <a
                      href={newUrl}
                      class:list={[
                        'flex items-center gap-2 font-sans text-[0.78rem] py-0.5',
                        isActive ? 'text-pe-rose-ink' : 'text-pe-muted hover:text-pe-rose-ink',
                      ]}
                    >
                      <span class:list={[
                        'w-3 h-3 border shrink-0 flex items-center justify-center',
                        isActive ? 'border-pe-rose bg-pe-rose' : 'border-pe-charcoal/30',
                      ]}>
                        {isActive && <Icon name="check" size={8} class="text-pe-white" strokeWidth={3} />}
                      </span>
                      {c === 'NEW' ? t('product.condition.new', locale) : t('product.condition.used', locale)}
                    </a>
                  );
                })}
              </div>
            </div>

            <!-- Brand text filter -->
            <div>
              <h3 class="pe-eyebrow mb-3">
                {locale === 'es' ? 'Marca' : 'Brand'}
              </h3>
              <div class="flex gap-1.5">
                <input
                  type="text"
                  name="brand"
                  value={brand ?? ''}
                  placeholder={locale === 'es' ? 'Buscar marca...' : 'Search brand...'}
                  class="flex-1 font-sans text-[0.78rem] bg-pe-white border border-pe-black/10 px-2.5 py-1.5 focus:outline-hidden focus:border-pe-rose/60 transition-colors duration-200"
                  aria-label={locale === 'es' ? 'Filtrar por marca' : 'Filter by brand'}
                />
                {category && <input type="hidden" name="category" value={category} />}
                {condition && <input type="hidden" name="condition" value={condition} />}
                <button
                  type="submit"
                  class="pe-btn-ink px-2.5 py-1.5 transition-colors"
                  aria-label={locale === 'es' ? 'Aplicar filtro' : 'Apply filter'}
                >
                  <Icon name="arrow-right" size={13} />
                </button>
              </div>
            </div>

            {activeFilters.length > 0 && (
              <a
                href={clearUrl}
                class="font-sans text-[0.72rem] text-pe-rose-ink hover:underline underline-offset-2 flex items-center gap-1"
              >
                <Icon name="x" size={11} />
                {locale === 'es' ? 'Limpiar filtros' : 'Clear filters'}
              </a>
            )}
          </form>
        </aside>

        <!-- Product grid -->
        <div class="flex-1 min-w-0">
          {productsPage.content.length > 0 ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-5 fx-stagger">
              {productsPage.content.map((product, i) => (
                <ProductCard product={product} locale={locale} priority={i < 3} token={token} />
              ))}
            </div>
          ) : (
            <div class="text-center py-24 flex flex-col items-center gap-4">
              <p class="font-display text-pe-charcoal/45 text-2xl">
                {locale === 'es' ? 'No se encontraron piezas' : 'No pieces found'}
              </p>
              <Button href={clearUrl} variant="outline">
                {locale === 'es' ? 'Ver toda la colección' : 'View full collection'}
              </Button>
            </div>
          )}

          <!-- Pagination -->
          {productsPage.totalPages > 1 && (
            <nav class="mt-12 flex justify-center gap-1.5" aria-label={locale === 'es' ? 'Paginación' : 'Pagination'}>
              {Array.from({ length: productsPage.totalPages }, (_, i) => (
                <a
                  href={`/${locale}/products?page=${i}${category ? `&category=${category}` : ''}${condition ? `&condition=${condition}` : ''}${brand ? `&brand=${brand}` : ''}`}
                  class:list={[
                    'font-sans text-xs w-8 h-8 flex items-center justify-center border transition-colors duration-200',
                    i === productsPage.number
                      ? 'bg-pe-rose-action text-pe-offwhite border-pe-rose'
                      : 'border-pe-black/15 text-pe-muted hover:border-pe-rose hover:text-pe-rose-ink',
                  ]}
                  aria-current={i === productsPage.number ? 'page' : undefined}
                >
                  {i + 1}
                </a>
              ))}
            </nav>
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const toggleButton = document.getElementById('products-cat-tree-toggle') as HTMLButtonElement | null;
  if (toggleButton) {
    const sidebar = toggleButton.closest('aside');
    const treeRoot = sidebar?.querySelector('.cat-tree-nav--sidebar') as HTMLElement | null;
    const icon = toggleButton.querySelector('[data-icon]') as HTMLElement | null;
    const initialBranches = treeRoot
      ? Array.from(treeRoot.querySelectorAll('details.cat-tree-branch')) as HTMLDetailsElement[]
      : [];

    if (initialBranches.length === 0) {
      toggleButton.disabled = true;
      toggleButton.classList.add('opacity-40', 'cursor-not-allowed');
    }

    const setExpanded = (expanded: boolean) => {
      if (!treeRoot) return;
      const branches = Array.from(treeRoot.querySelectorAll('details.cat-tree-branch')) as HTMLDetailsElement[];
      branches.forEach((branch) => { branch.open = expanded; });
      toggleButton.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      const nextLabel = expanded
        ? (toggleButton.dataset.labelCollapse ?? 'Collapse categories')
        : (toggleButton.dataset.labelExpand ?? 'Expand categories');
      toggleButton.setAttribute('aria-label', nextLabel);
      toggleButton.title = nextLabel;
      if (icon) icon.textContent = expanded ? '▾' : '▸';
    };

    toggleButton.addEventListener('click', () => {
      const expanded = toggleButton.getAttribute('aria-expanded') === 'true';
      setExpanded(!expanded);
    });
  }
</script>
