---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WishlistButton from '../../../islands/wishlist/WishlistButton';
import ProductVariantSelector from '../../../islands/product/ProductVariantSelector';
import ReviewList from '../../../islands/reviews/ReviewList';
import ReviewForm from '../../../islands/reviews/ReviewForm';
import RatingStars from '../../../components/RatingStars.astro';
import CuotasDisplay from '../../../components/CuotasDisplay.astro';
import DeliveryEstimate from '../../../components/DeliveryEstimate.astro';
import { type Locale, SUPPORTED_LOCALES, t } from '../../../i18n/index';
import { getProduct } from '../../../lib/api';
import { summarizeProductVariantSecondaryValues } from '../../../lib/productVariants';
import { getProductVariantSchema, getSecondaryAttribute } from '../../../lib/variantSchema';

const { locale, id } = Astro.params as { locale: Locale; id: string };

if (!SUPPORTED_LOCALES.includes(locale)) {
  return Astro.redirect('/es/products');
}

let product;
try {
  product = await getProduct(id);
} catch {
  return Astro.redirect(`/${locale}/products`);
}

const token = Astro.cookies.get('pe_token')?.value;
const userId = Astro.cookies.get('pe_user_id')?.value;

const priceFormatted = new Intl.NumberFormat('es-CL', {
  style: 'currency',
  currency: product.price.currency,
  maximumFractionDigits: 0,
}).format(product.price.amount);
const hasDiscount =
  !!product.listPrice
  && product.listPrice.currency === product.price.currency
  && product.listPrice.amount > product.price.amount;
const listPriceFormatted = hasDiscount
  ? new Intl.NumberFormat('es-CL', {
      style: 'currency',
      currency: product.listPrice!.currency,
      maximumFractionDigits: 0,
    }).format(product.listPrice!.amount)
  : null;
const discountPct = hasDiscount
  ? Math.round((1 - product.price.amount / product.listPrice!.amount) * 100)
  : null;

const conditionLabel =
  product.condition === 'NEW'
    ? t('product.condition.new', locale)
    : t('product.condition.used', locale);

const zone = (product.shippingOriginZone ?? 'SANTIAGO') as 'SANTIAGO' | 'RM' | 'REGIONES';
const variantSchema = getProductVariantSchema(product);
const secondaryAttribute = getSecondaryAttribute(variantSchema);
const sizesSummary = summarizeProductVariantSecondaryValues(product);
---

<BaseLayout title={product.name} description={product.description} locale={locale}>
  <style>
    @keyframes pe-fade-in {
      from { opacity: 0; transform: scale(1.025); }
      to   { opacity: 1; transform: scale(1); }
    }
    @keyframes pe-slide-up {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .pe-product-img {
      animation: pe-fade-in 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .pe-detail-item {
      animation: pe-slide-up 560ms cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--delay, 0ms);
    }

    @media (prefers-reduced-motion: reduce) {
      .pe-product-img,
      .pe-detail-item { animation: none; }
    }
  </style>

  <div class="py-12 min-h-screen" style="background-color: var(--pe-surface)">
    <div class="pe-container">
      <!-- Breadcrumb -->
      <nav class="mb-8 font-sans text-xs text-[#3A3A3A]/50 flex items-center gap-2" aria-label="Breadcrumb">
        <a href={`/${locale}/`} class="hover:text-[#B76E79] transition-colors">{t('nav.home', locale)}</a>
        <span aria-hidden="true">›</span>
        <a href={`/${locale}/products`} class="hover:text-[#B76E79] transition-colors">{t('nav.products', locale)}</a>
        <span aria-hidden="true">›</span>
        <span class="text-[#1A1A1A]/70">{product.name}</span>
      </nav>

      <!-- Product grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Image -->
        <div class="aspect-[3/4] overflow-hidden bg-[#EDE3D8] relative pe-product-img">
          <img
            src={product.imageUrl}
            alt={product.name}
            class="w-full h-full object-cover"
            width="600"
            height="800"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <!-- Details panel -->
        <div class="lg:sticky lg:top-24 flex flex-col gap-6">
          <!-- Brand + condition -->
          <div class="pe-detail-item flex items-center justify-between" style="--delay: 60ms">
            <span class="font-sans text-[10px] tracking-[0.4em] uppercase text-[#B76E79] font-medium">
              {product.brand}
            </span>
            <span
              class:list={[
                'font-sans text-[9px] tracking-wider uppercase px-2.5 py-1 border',
                product.condition === 'NEW'
                  ? 'bg-[#1A1A1A] text-[#F2EAE0] border-[#1A1A1A]'
                  : 'bg-[#E8C9CC] text-[#8E4F58] border-[#E8C9CC]',
              ]}
            >
              {conditionLabel}
            </span>
          </div>

          <!-- Name -->
          <h1
            class="pe-detail-item font-['Cormorant_Garamond',serif] text-[#1A1A1A] text-3xl md:text-4xl font-light italic leading-tight"
            style="--delay: 140ms"
          >
            {product.name}
          </h1>

          <!-- Rating stars -->
          {(product.avgRating ?? 0) > 0 && (
            <a href="#resenas" class="pe-detail-item flex items-center gap-2" style="--delay: 210ms">
              <RatingStars value={product.avgRating ?? 0} count={product.reviewCount} />
            </a>
          )}

          <!-- Price -->
          <div class="pe-detail-item flex items-baseline gap-3" style="--delay: 280ms">
            {hasDiscount && (
              <span class="font-sans text-base text-[#3A3A3A]/45 line-through tabular-nums">
                {listPriceFormatted}
              </span>
            )}
            <span class="font-['Cormorant_Garamond',serif] text-3xl text-[#1A1A1A] tabular-nums">
              {priceFormatted}
            </span>
            {discountPct !== null && (
              <span class="font-sans text-xs uppercase tracking-[0.12em] text-[#B76E79]">-{discountPct}%</span>
            )}
          </div>

          <!-- Add to cart + wishlist action row -->
          <div class="pe-detail-item flex flex-col gap-2 mt-2" style="--delay: 380ms">
            {sizesSummary && (
              <p class="font-sans text-[10px] tracking-[0.14em] uppercase text-[#3A3A3A]/55">
                {secondaryAttribute.label}: {sizesSummary}
              </p>
            )}
            <ProductVariantSelector
              client:load
              productId={product.id}
              name={product.name}
              brand={product.brand}
              price={product.price}
              imageUrl={product.imageUrl}
              condition={product.condition}
              stock={product.stock}
              categoryTypes={product.categoryTypes}
              variants={product.variants}
              locale={locale}
            />
            <WishlistButton
              client:load
              productId={product.id}
              token={token}
              showLabel={true}
              locale={locale}
              className="w-full px-4 py-2.5 border border-[var(--pe-border)] hover:border-[#B76E79] text-[var(--pe-ink)] bg-transparent focus:outline-hidden focus-visible:ring-2 focus-visible:ring-[#B76E79] focus-visible:ring-offset-1"
            />
          </div>

          <!-- Divider -->
          <div class="pe-detail-item w-full h-px bg-[#EDE3D8]" style="--delay: 440ms"></div>

          <!-- Cuotas -->
          <div class="pe-detail-item" style="--delay: 480ms">
            <CuotasDisplay priceAmount={product.price.amount} locale={locale} />
          </div>

          <!-- Delivery estimate -->
          <div class="pe-detail-item" style="--delay: 530ms">
            <DeliveryEstimate zone={zone} locale={locale} />
          </div>

          <!-- Buyer rights: retracto (Ley 21.398) and the six-month legal warranty (Ley 19.496 art. 21) -->
          <div class="pe-detail-item space-y-1.5" style="--delay: 555ms">
            <p class="font-sans text-[10px] tracking-widest uppercase text-[#3A3A3A]/50">
              {locale === 'es' ? 'Tu compra está protegida' : 'Your purchase is protected'}
            </p>
            <p class="font-sans text-[13px] leading-relaxed text-[#3A3A3A]/85 max-w-[62ch]">
              {locale === 'es'
                ? '10 días para arrepentirte desde que recibes el pedido, sin dar explicaciones, con el envío de vuelta pagado por nosotros. Y 6 meses de garantía legal si la prenda llega con una falla o no corresponde a lo publicado.'
                : '10 days to change your mind from the moment it arrives, no explanation needed, with return shipping on us. Plus a 6-month legal warranty if the garment arrives faulty or does not match the listing.'}
            </p>
            <a
              href={`/${locale}/shipping-returns`}
              class="inline-block font-sans text-[11px] tracking-wide text-[#3A3A3A]/55 underline underline-offset-4 decoration-[#3A3A3A]/25 hover:text-[#B76E79] hover:decoration-[#B76E79] transition-colors"
            >
              {locale === 'es' ? 'Cómo funciona' : 'How it works'}
            </a>
          </div>

          <!-- Description -->
          <div class="pe-detail-item" style="--delay: 580ms">
            <p class="font-sans text-[10px] tracking-widest uppercase text-[#3A3A3A]/50 mb-3">
              {locale === 'es' ? 'Descripción' : 'Description'}
            </p>
            <p class="font-sans text-[#3A3A3A] leading-relaxed text-sm">
              {product.description}
            </p>
          </div>

          <!-- Back link -->
          <a
            href={`/${locale}/products`}
            class="pe-detail-item inline-flex items-center gap-1.5 text-xs tracking-widest uppercase text-[#3A3A3A]/50 hover:text-[#B76E79] transition-colors mt-2"
            style="--delay: 640ms"
          >
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M8.5 2.5L4 7l4.5 4.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="square" stroke-linejoin="miter"/>
            </svg>
            {locale === 'es' ? 'Volver al catálogo' : 'Back to catalogue'}
          </a>
        </div>
      </div>

      <!-- Reviews section -->
      <section id="resenas" class="mt-20 max-w-2xl">
        <div class="flex items-center gap-4 mb-8">
          <h2 class="font-['Cormorant_Garamond',serif] text-2xl text-[#1A1A1A]">
            {locale === 'es' ? 'Reseñas' : 'Reviews'}
          </h2>
          {(product.avgRating ?? 0) > 0 && (
            <RatingStars value={product.avgRating ?? 0} count={product.reviewCount} />
          )}
        </div>

        <ReviewList client:visible productId={product.id} locale={locale} token={token} userId={userId} />
        <ReviewForm
          client:visible
          productId={product.id}
          token={token}
          userId={userId}
          locale={locale}
        />
      </section>
    </div>
  </div>
</BaseLayout>
