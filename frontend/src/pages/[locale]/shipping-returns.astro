---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { SUPPORTED_LOCALES, type Locale } from '../../i18n/index';
import { getPublicShippingConfig } from '../../lib/api';

const { locale } = Astro.params as { locale: Locale };

if (!SUPPORTED_LOCALES.includes(locale)) {
  return Astro.redirect('/es/shipping-returns');
}

const isEs = locale === 'es';

const shippingConfig = await getPublicShippingConfig();
const activeZones = shippingConfig.zones.filter((z) => z.active);
const inactiveZones = shippingConfig.zones.filter((z) => !z.active);
const activeCouriers = shippingConfig.couriers.filter((c) => c.active);

function buildZoneNote(comunas: string[], extra: string): string {
  const head = comunas.length > 0 ? comunas.join(', ') + (extra ? '. ' : '') : '';
  return (head + extra).trim();
}

const shippingZones = activeZones.map((z) => ({
  zone: isEs ? z.titleEs : z.titleEn,
  eta: isEs ? z.etaEs : z.etaEn,
  note: buildZoneNote(z.comunas, isEs ? 'Despacho disponible.' : 'Shipping available.'),
}));

const unavailableZones = inactiveZones.map((z) => isEs ? z.titleEs : z.titleEn);

const couriersLabel = activeCouriers.map((c) => c.name).join(' o ') || (isEs ? 'courier autorizado' : 'authorized courier');
const paymentLabel = isEs ? 'Envío por pagar' : 'Cash on delivery (shipping cost)';

/**
 * Rights, not courtesies: art. 3 bis of the Ley 19.496 (retracto), art. 21 as amended by the
 * Ley 21.398 (six months of legal warranty) and the 45-day cap on giving the money back.
 * Nothing here may be narrowed by the shop, so the copy states the plain minimum the law sets.
 */
const returns = isEs
  ? [
      {
        title: '10 días para arrepentirte',
        body: 'Desde que recibes el pedido tienes 10 días corridos para dejarlo sin efecto, sin dar explicaciones. La solicitud se hace desde Mi Cuenta, en el detalle del pedido.',
      },
      {
        title: 'El envío de vuelta lo pagamos nosotros',
        body: 'Coordinamos el retiro o te enviamos la etiqueta. No retenemos gastos de ningún tipo: se te devuelve todo lo que pagaste.',
      },
      {
        title: 'La prenda vuelve como llegó',
        body: 'Sin uso más allá de probártela, con sus etiquetas y en el mismo estado en que te la entregamos. Cada prenda que recibimos pasa por limpieza, planchado, sanitización y reparación antes de volver a la tienda.',
      },
      {
        title: 'El dinero, en 45 días como máximo',
        body: 'Te devolvemos por el mismo medio con que pagaste, apenas recibimos la prenda de vuelta y siempre dentro del plazo legal de 45 días. Si pagaste por transferencia, te pediremos tu cuenta para depositarte.',
      },
      {
        title: '6 meses de garantía legal',
        body: 'Si la prenda llega con una falla o no corresponde a lo publicado, tienes 6 meses para elegir entre reparación, cambio o la devolución del dinero. Esto es aparte del arrepentimiento y no depende de él.',
      },
      {
        title: 'Cada prenda se publica como es',
        body: 'Describimos el estado real, incluidas las marcas de uso, y las fotos son de la pieza que recibes. Si algo no calza con lo que viste, es una falla y entra en la garantía.',
      },
    ]
  : [
      {
        title: '10 days to change your mind',
        body: 'From the day your order arrives you have 10 calendar days to withdraw, with no explanation needed. Request it from My Account, in the order detail.',
      },
      {
        title: 'Return shipping is on us',
        body: 'We arrange the pickup or send you the label. We retain no costs of any kind: you get back everything you paid.',
      },
      {
        title: 'The garment comes back as it arrived',
        body: 'Unworn beyond trying it on, tags attached, in the same condition we delivered it. Every returned garment is cleaned, pressed, sanitised and repaired before going back on sale.',
      },
      {
        title: 'Your money back within 45 days',
        body: 'Refunded through the same method you paid with, as soon as the garment reaches us and always inside the 45-day legal limit. If you paid by bank transfer we will ask for your account details.',
      },
      {
        title: 'Six months of legal warranty',
        body: 'If the garment arrives faulty or does not match the listing, you have 6 months to choose repair, replacement or a refund. This is separate from withdrawal and does not depend on it.',
      },
      {
        title: 'Every garment is listed as it is',
        body: 'We describe the real condition, wear marks included, and the photos show the exact piece you receive. If something does not match what you saw, that is a fault and the warranty covers it.',
      },
    ];
---

<BaseLayout
  title={isEs ? 'Envios y devoluciones' : 'Shipping and returns'}
  description={isEs ? 'Conoce tiempos de envio y politicas de devolucion de Pilar Estilo.' : 'Understand Pilar Estilo shipping times and return policy.'}
  locale={locale}
>
  <div class="bg-pe-offwhite">
    <section class="relative overflow-hidden border-b border-pe-black/10 bg-pe-cream">
      <div class="absolute -top-32 left-1/2 h-[34rem] w-[34rem] -translate-x-1/2 rounded-full border border-pe-rose/20" aria-hidden="true"></div>
      <div class="pe-container py-16 md:py-20 text-center relative z-[1]">
        <p class="pe-eyebrow text-pe-rose-ink mb-4">
          {isEs ? 'Informacion logistica' : 'Logistics information'}
        </p>
        <h1 class="font-display text-pe-black text-4xl md:text-6xl font-light tracking-tight">
          {isEs ? 'Envios y devoluciones' : 'Shipping and returns'}
        </h1>
        <p class="mt-6 mx-auto max-w-3xl font-sans text-sm md:text-base text-pe-charcoal leading-relaxed">
          {isEs
            ? 'Trabajamos para que tu compra llegue segura y en tiempo, con reglas claras para revisiones y devoluciones.'
            : 'We make sure your order arrives safely and on time, with clear rules for reviews and returns.'}
        </p>
      </div>
    </section>

    <section class="py-14 md:py-20">
      <div class="pe-container">
        <h2 class="font-display text-3xl md:text-4xl text-pe-black font-light mb-6 md:mb-8">
          {isEs ? 'Tiempos de envio estimados' : 'Estimated shipping windows'}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
          {shippingZones.map((item) => (
            <article class="bg-pe-white border border-pe-black/10 p-6 md:p-7">
              <p class="font-sans text-[0.68rem] tracking-[0.2em] uppercase text-pe-rose-ink mb-2">{item.zone}</p>
              <h3 class="font-display text-2xl text-pe-black font-light mb-2">{item.eta}</h3>
              <p class="font-sans text-sm text-pe-charcoal leading-relaxed">{item.note}</p>
            </article>
          ))}
        </div>

        <article class="mt-8 bg-pe-cream/60 border border-pe-rose/20 p-6 md:p-7">
          <p class="font-sans text-[0.68rem] tracking-[0.2em] uppercase text-pe-rose-ink mb-2">
            {isEs ? 'Modalidad de despacho' : 'Shipping method'}
          </p>
          <h3 class="font-display text-xl text-pe-black font-light mb-2">
            {couriersLabel} ({paymentLabel.toLowerCase()})
          </h3>
          <p class="font-sans text-sm text-pe-charcoal leading-relaxed">
            {isEs
              ? `El costo de envío se paga al retirar en sucursal del courier. Despachamos desde Los Andes; te enviamos el número de seguimiento una vez en tránsito.`
              : `Shipping cost is paid at pickup at the courier branch. Dispatched from Los Andes; tracking number shared once the parcel is in transit.`}
          </p>
          {unavailableZones.length > 0 && (
            <p class="mt-3 font-sans text-[0.72rem] text-pe-muted italic">
              {isEs ? 'Zonas temporalmente no disponibles' : 'Zones currently unavailable'}: {unavailableZones.join(', ')}.
            </p>
          )}
        </article>
      </div>
    </section>

    <section class="bg-pe-black py-14 md:py-16">
      <div class="pe-container">
        <h2 class="font-display text-3xl md:text-4xl text-pe-on-dark font-light mb-3">
          {isEs ? 'Devoluciones y garantía' : 'Returns and warranty'}
        </h2>
        <p class="font-sans text-sm text-pe-on-dark-muted leading-relaxed max-w-2xl mb-8 md:mb-10">
          {isEs
            ? 'Lo que sigue no son concesiones nuestras: es lo que la ley chilena te reconoce en toda compra a distancia. Lo escribimos aquí para que no tengas que ir a buscarlo.'
            : 'What follows is not a favour from us: it is what Chilean law grants you on every distance purchase. We spell it out here so you do not have to go looking for it.'}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-8 md:gap-y-10">
          {returns.map((rule) => (
            <article>
              <h3 class="font-sans text-[0.72rem] tracking-[0.2em] uppercase text-pe-rose-soft mb-3">
                {rule.title}
              </h3>
              <p class="font-sans text-sm text-pe-on-dark leading-relaxed max-w-[62ch]">{rule.body}</p>
            </article>
          ))}
        </div>
        <div class="mt-12 flex flex-wrap gap-3">
          <Button href={`/${locale}/account`} variant="primary" trailingIcon="arrow-right">
            {isEs ? 'Ir a mis pedidos' : 'Go to my orders'}
          </Button>
          <Button href={`/${locale}/contact`} variant="outline-light">
            {isEs ? 'Hablar con soporte' : 'Contact support'}
          </Button>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
