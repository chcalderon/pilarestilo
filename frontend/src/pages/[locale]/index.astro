---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProductCard from '../../components/ProductCard.astro';
import Button from '../../components/Button.astro';
import { SUPPORTED_LOCALES, type Locale, t } from '../../i18n/index';
import { getFeaturedProducts, getCategoryTree, FIXTURE_PRODUCTS } from '../../lib/api';

const { locale } = Astro.params as { locale: Locale };

if (!SUPPORTED_LOCALES.includes(locale)) {
  return Astro.redirect('/es/');
}

let featured = [...FIXTURE_PRODUCTS];
try {
  featured = await getFeaturedProducts();
} catch {
  // fixture fallback already set
}

const token = Astro.cookies.get('pe_token')?.value;
const categoryTree = await getCategoryTree();
const featuredProducts = featured.slice(0, 8);
const brandPillars = locale === 'es'
  ? [
      {
        title: 'Curaduria real',
        body: 'Cada prenda se publica solo despues de una seleccion manual de estilo y estado.',
      },
      {
        title: 'Circular y premium',
        body: 'Moda consciente, piezas unicas y marcas seleccionadas con mirada editorial.',
      },
      {
        title: 'Compra clara',
        body: 'Precio, condicion y stock visibles para decidir rapido y comprar con confianza.',
      },
    ]
  : [
      {
        title: 'Real curation',
        body: 'Every garment is listed only after a manual review for style and condition.',
      },
      {
        title: 'Circular and premium',
        body: 'Mindful fashion, unique pieces, and selected brands with an editorial eye.',
      },
      {
        title: 'Clear purchase',
        body: 'Price, condition, and stock stay visible so customers can decide quickly.',
      },
    ];

function collectFeatured(nodes: typeof categoryTree): typeof categoryTree {
  const result: typeof categoryTree = [];

  for (const node of nodes) {
    if (node.featured && node.active) {
      result.push(node);
    }

    if (node.children?.length) {
      result.push(...collectFeatured(node.children));
    }
  }

  return result;
}

const categoryTiles = collectFeatured(categoryTree);
---

<BaseLayout title={t('nav.home', locale)} locale={locale}>
  <Hero locale={locale} />

  <section class="py-10 md:py-12 bg-pe-offwhite border-y border-pe-black/8" aria-label={locale === 'es' ? 'Valor de Pilar Estilo' : 'Pilar Estilo value'}>
    <div class="pe-container">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        {brandPillars.map((pillar, i) => (
          <article class="pe-home-pillar">
            <p class="font-sans text-[0.65rem] tracking-[0.24em] uppercase text-pe-rose-ink">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h2 class="font-display text-pe-black text-2xl md:text-[1.9rem] font-light mt-2 leading-tight">
              {pillar.title}
            </h2>
            <p class="font-sans text-sm md:text-[0.92rem] leading-relaxed text-pe-muted mt-3 max-w-[36ch]">
              {pillar.body}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-pe-cream" aria-labelledby="featured-heading">
    <div class="pe-container">
      <div class="text-center mb-12">
        <span class="chapter-mark text-base">
          {locale === 'es' ? 'Novedades' : 'New arrivals'}
        </span>

        <h2
          id="featured-heading"
          class="font-display text-pe-black text-3xl md:text-4xl font-light mt-3"
        >
          {locale === 'es' ? 'Recien Llegados' : 'Recently Added'}
        </h2>

        <p class="font-sans text-sm md:text-[0.92rem] leading-relaxed text-pe-muted max-w-[58ch] mx-auto mt-4">
          {locale === 'es'
            ? 'Una seleccion breve para descubrir primero lo mas nuevo de la vitrina.'
            : 'A short edit to discover the newest arrivals first.'}
        </p>
      </div>

      {featuredProducts.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5 fx-stagger">
          {featuredProducts.map((product) => (
            <ProductCard product={product} locale={locale} priority={true} token={token} />
          ))}
        </div>
      ) : (
        <p class="text-center text-pe-muted font-sans text-sm">
          {locale === 'es' ? 'No hay productos disponibles.' : 'No products available.'}
        </p>
      )}

      <div class="text-center mt-12">
        <Button href={`/${locale}/products`} variant="outline" trailingIcon="arrow-right">
          {locale === 'es' ? 'Ver toda la coleccion' : 'View full collection'}
        </Button>
      </div>
    </div>
  </section>

  <section class="py-16 bg-pe-offwhite" aria-labelledby="categories-heading">
    <div class="pe-container">
      <div class="text-center mb-10">
        <span class="chapter-mark text-base">
          {locale === 'es' ? 'Explorar' : 'Explore'}
        </span>

        <h2
          id="categories-heading"
          class="font-display text-pe-black text-3xl md:text-4xl font-light mt-3"
        >
          {locale === 'es' ? 'Por Categoria' : 'By Category'}
        </h2>

        <p class="font-sans text-sm md:text-[0.92rem] leading-relaxed text-pe-muted max-w-[60ch] mx-auto mt-4">
          {locale === 'es'
            ? 'Explora familias de productos con subcategorias para llegar mas rapido a lo que buscas.'
            : 'Browse product families with subcategories to get faster to what you are looking for.'}
        </p>
      </div>

      {categoryTiles.length === 0 ? (
        <p class="text-center text-pe-muted font-sans text-sm py-8">
          {locale === 'es' ? 'Proximamente.' : 'Coming soon.'}
        </p>
      ) : (
        <div data-pe-carousel class="pe-carousel relative overflow-hidden" role="region" aria-label={locale === 'es' ? 'Carrusel de categorias' : 'Category carousel'}>
          <div
            class="pointer-events-none absolute inset-y-0 left-0 w-10 z-[2]"
            style="background: linear-gradient(to right, var(--pe-surface), transparent)"
          ></div>

          <div
            class="pointer-events-none absolute inset-y-0 right-0 w-10 z-[2]"
            style="background: linear-gradient(to left, var(--pe-surface), transparent)"
          ></div>

          <div class="overflow-hidden px-1 pb-3">
            <div data-pe-carousel-track class="pe-carousel-track">
              {categoryTiles.map((cat, i) => {
                const name = locale === 'es' ? cat.nameEs : (cat.nameEn || cat.nameEs);
                const subs = (cat.children ?? []).filter(s => s.active).slice(0, 4);

                return (
                  <article class="pe-carousel-slide group relative overflow-hidden aspect-[4/5] fx-lift">
                    <a
                      href={`/${locale}/categories/${cat.slug}`}
                      class="absolute inset-0 block z-0"
                      aria-label={name}
                    >
                      {cat.imageUrl ? (
                        <img
                          src={cat.imageUrl}
                          alt={name}
                          loading={i === 0 ? 'eager' : 'lazy'}
                          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                          width="600"
                          height="750"
                          draggable="false"
                        />
                      ) : (
                        <div class="w-full h-full bg-pe-cream"></div>
                      )}

                      <div class="absolute inset-0 bg-gradient-to-t from-pe-black/75 via-pe-black/20 to-transparent"></div>
                      <div class="absolute bottom-0 left-0 right-0 h-[2px] bg-pe-rose scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
                    </a>

                    <div class="absolute bottom-0 left-0 right-0 p-5 z-10 pointer-events-none">
                      <p class="font-display text-pe-on-dark text-xl md:text-2xl font-light leading-tight">
                        {name}
                      </p>

                      {subs.length > 0 && (
                        <div class="flex flex-wrap gap-1.5 mt-2 pointer-events-auto">
                          {subs.map(sub => (
                            <a
                              href={`/${locale}/categories/${sub.slug}`}
                              class="font-sans text-[0.58rem] tracking-[0.2em] uppercase text-pe-on-dark-muted border border-pe-offwhite/22 px-2 py-0.5 hover:text-pe-on-dark hover:border-pe-offwhite/50 transition-colors"
                            >
                              {locale === 'es' ? sub.nameEs : (sub.nameEn || sub.nameEs)}
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </div>

          <div data-pe-carousel-controls class="mt-6 flex items-center justify-between gap-4">
            <div data-pe-carousel-dots class="flex items-center gap-2">
              {categoryTiles.map((_, i) => (
                <button
                  type="button"
                  data-pe-carousel-dot={i}
                  class={`h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'w-6' : 'w-3'}`}
                  style={i === 0 ? 'background-color: var(--pe-ink)' : 'background-color: color-mix(in srgb, var(--pe-ink) 28%, transparent)'}
                  aria-label={locale === 'es' ? `Ir a categoria ${i + 1}` : `Go to category ${i + 1}`}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                ></button>
              ))}
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                data-pe-carousel-toggle
                data-label-play={locale === 'es' ? 'Reproducir' : 'Play'}
                data-label-pause={locale === 'es' ? 'Pausar' : 'Pause'}
                data-hint={locale === 'es' ? 'Click corto abre categoria. Mantener presionado no abre enlace.' : 'Short click opens category. Long press does not open link.'}
                class="min-w-[8.2rem] h-10 px-4 inline-flex items-center justify-center border border-pe-charcoal/20 text-pe-charcoal hover:border-pe-charcoal/40 hover:bg-pe-cream transition-colors font-sans text-[0.62rem] tracking-[0.2em] uppercase"
                aria-pressed="false"
                title={locale === 'es' ? 'Click corto abre categoria. Mantener presionado no abre enlace.' : 'Short click opens category. Long press does not open link.'}
              >
                {locale === 'es' ? 'Pausar' : 'Pause'}
              </button>

              <button
                type="button"
                data-pe-carousel-prev
                class="h-10 w-10 inline-flex items-center justify-center rounded-full border border-pe-charcoal/20 text-pe-charcoal hover:border-pe-charcoal/40 hover:bg-pe-cream transition-colors"
                aria-label={locale === 'es' ? 'Categoria anterior' : 'Previous category'}
              >
                <span aria-hidden="true">&larr;</span>
              </button>

              <button
                type="button"
                data-pe-carousel-next
                class="h-10 w-10 inline-flex items-center justify-center rounded-full border border-pe-charcoal/20 text-pe-charcoal hover:border-pe-charcoal/40 hover:bg-pe-cream transition-colors"
                aria-label={locale === 'es' ? 'Siguiente categoria' : 'Next category'}
              >
                <span aria-hidden="true">&rarr;</span>
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <style>
    .pe-carousel {
      --pe-carousel-gap: 1rem;
      cursor: grab;
      user-select: none;
      touch-action: pan-y;
    }

    .pe-carousel.is-dragging {
      cursor: grabbing;
    }

    .pe-carousel-track {
      display: flex;
      gap: var(--pe-carousel-gap);
      transform: translate3d(0, 0, 0);
      transition: transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }

    .pe-carousel-track.is-resetting,
    .pe-carousel-track.is-dragging {
      transition: none;
    }

    .pe-home-pillar + .pe-home-pillar {
      border-top: 1px solid color-mix(in srgb, var(--pe-border) 70%, transparent);
      padding-top: 1.25rem;
    }

    @media (min-width: 768px) {
      .pe-home-pillar + .pe-home-pillar {
        border-top: 0;
        border-left: 1px solid color-mix(in srgb, var(--pe-border) 70%, transparent);
        padding-top: 0;
        padding-left: 2rem;
      }
    }

    .pe-carousel-slide {
      flex: 0 0 82%;
    }

    .pe-carousel-slide.is-clone {
      pointer-events: none;
    }

    @media (min-width: 640px) {
      .pe-carousel-slide {
        flex-basis: calc((100% - var(--pe-carousel-gap)) / 2);
      }
    }

    @media (min-width: 1024px) {
      .pe-carousel-slide {
        flex-basis: calc((100% - (var(--pe-carousel-gap) * 2)) / 3);
      }
    }
  </style>

  <script is:inline>
    (function () {
      function setupCarousel(root) {
        if (root.dataset.peCarouselReady === 'true') return;
        root.dataset.peCarouselReady = 'true';

        var track = root.querySelector('[data-pe-carousel-track]');
        var prevButton = root.querySelector('[data-pe-carousel-prev]');
        var nextButton = root.querySelector('[data-pe-carousel-next]');
        var toggleButton = root.querySelector('[data-pe-carousel-toggle]');
        var controls = root.querySelector('[data-pe-carousel-controls]');
        var dots = Array.prototype.slice.call(root.querySelectorAll('[data-pe-carousel-dot]'));

        if (!track || !prevButton || !nextButton) return;

        var originalSlides = Array.prototype.slice.call(track.children);
        var originalCount = originalSlides.length;

        if (originalCount <= 1) {
          prevButton.style.display = 'none';
          nextButton.style.display = 'none';
          return;
        }

        var cloneCount = Math.min(3, originalCount);
        var index = cloneCount;
        var timer = null;
        var autoplayMs = 4000;
        var startX = 0;
        var currentX = 0;
        var dragDelta = 0;
        var isDragging = false;
        var hasDragged = false;
        var pressedLink = null;
        var downLink = null;
        var pointerDownAt = 0;
        var suppressClickOnce = false;
        var longPressMs = 420;
        var autoplayEnabled = true;

        function syncToggleButton() {
          if (!toggleButton) return;

          var playLabel = toggleButton.getAttribute('data-label-play') || 'Play';
          var pauseLabel = toggleButton.getAttribute('data-label-pause') || 'Pause';
          var hint = toggleButton.getAttribute('data-hint') || '';
          var buttonLabel = autoplayEnabled ? pauseLabel : playLabel;

          toggleButton.textContent = buttonLabel;
          toggleButton.setAttribute('aria-pressed', autoplayEnabled ? 'true' : 'false');
          toggleButton.setAttribute('aria-label', buttonLabel);
          toggleButton.setAttribute('title', hint);
        }

        function buildInfiniteSlides() {
          var firstClones = originalSlides.slice(0, cloneCount).map(function (slide) {
            var clone = slide.cloneNode(true);
            clone.classList.add('is-clone');
            clone.setAttribute('aria-hidden', 'true');
            return clone;
          });

          var lastClones = originalSlides.slice(-cloneCount).map(function (slide) {
            var clone = slide.cloneNode(true);
            clone.classList.add('is-clone');
            clone.setAttribute('aria-hidden', 'true');
            return clone;
          });

          lastClones.forEach(function (clone) {
            track.insertBefore(clone, track.firstChild);
          });

          firstClones.forEach(function (clone) {
            track.appendChild(clone);
          });
        }

        function getGap() {
          var styles = window.getComputedStyle(track);
          return parseFloat(styles.columnGap || styles.gap || '0') || 0;
        }

        function getStep() {
          var slide = track.children[0];
          if (!slide) return 0;

          return slide.getBoundingClientRect().width + getGap();
        }

        function getRealIndex() {
          return (index - cloneCount + originalCount) % originalCount;
        }

        function setTransform(withTransition) {
          var step = getStep();
          var offset = index * step - dragDelta;

          track.classList.toggle('is-resetting', !withTransition);
          track.style.transform = 'translate3d(-' + offset + 'px, 0, 0)';

          if (!withTransition) {
            requestAnimationFrame(function () {
              track.classList.remove('is-resetting');
            });
          }

          updateDots();
        }

        function updateDots() {
          var activeIndex = getRealIndex();

          dots.forEach(function (dot, dotIndex) {
            var active = dotIndex === activeIndex;

            dot.classList.toggle('w-6', active);
            dot.classList.toggle('w-3', !active);
            dot.setAttribute('aria-pressed', active ? 'true' : 'false');
            dot.setAttribute('aria-current', active ? 'true' : 'false');

            dot.style.backgroundColor = active
              ? 'var(--pe-ink)'
              : 'color-mix(in srgb, var(--pe-ink) 28%, transparent)';
          });
        }

        function goTo(newIndex) {
          dragDelta = 0;
          index = newIndex;
          setTransform(true);
        }

        function next() {
          goTo(index + 1);
        }

        function prev() {
          goTo(index - 1);
        }

        function normalizeAfterTransition() {
          if (index >= cloneCount + originalCount) {
            index = cloneCount;
            setTransform(false);
          }

          if (index < cloneCount) {
            index = cloneCount + originalCount - 1;
            setTransform(false);
          }
        }

        function stopAutoplay() {
          if (timer !== null) {
            window.clearInterval(timer);
            timer = null;
          }
        }

        function startAutoplay() {
          stopAutoplay();

          if (!autoplayEnabled) return;
          if (document.hidden) return;

          timer = window.setInterval(function () {
            next();
          }, autoplayMs);
        }

        function pauseAutoplay() {
          stopAutoplay();
        }

        function resumeAutoplay() {
          startAutoplay();
        }

        function toggleAutoplay() {
          autoplayEnabled = !autoplayEnabled;
          syncToggleButton();

          if (autoplayEnabled) {
            startAutoplay();
          } else {
            stopAutoplay();
          }
        }

        function onPointerDown(event) {
          if (event.pointerType === 'mouse' && event.button !== 0) return;
          var target = null;
          if (event.target instanceof Element) {
            target = event.target;
          } else if (event.target && event.target.parentElement) {
            target = event.target.parentElement;
          }
          if (target && target.closest('[data-pe-carousel-controls]')) return;

          downLink = target ? target.closest('a[href]') : null;
          pointerDownAt = Date.now();
          suppressClickOnce = false;
          if (downLink) return;

          isDragging = true;
          hasDragged = false;
          pressedLink = target ? target.closest('a[href]') : null;
          startX = event.clientX;
          currentX = startX;
          dragDelta = 0;

          root.classList.add('is-dragging');
          track.classList.add('is-dragging');
          pauseAutoplay();

          if (root.setPointerCapture) {
            root.setPointerCapture(event.pointerId);
          }
        }

        function onPointerMove(event) {
          if (!isDragging) return;

          currentX = event.clientX;
          dragDelta = currentX - startX;

          if (Math.abs(dragDelta) > 8) {
            hasDragged = true;
          }

          setTransform(false);
        }

        function onPointerUp(event) {
          if (!isDragging) return;

          isDragging = false;
          root.classList.remove('is-dragging');
          track.classList.remove('is-dragging');

          if (root.releasePointerCapture) {
            try {
              root.releasePointerCapture(event.pointerId);
            } catch {
              // Capture can already be gone (pointer cancelled elsewhere) -- nothing to do about it.
            }
          }

          var pressElapsed = Date.now() - pointerDownAt;

          if (!hasDragged && pressedLink) {
            // Keep native link behavior for short click/tap.
            // For long press, block navigation to avoid accidental open.
            if (pressElapsed >= longPressMs) {
              suppressClickOnce = true;
            }

            pressedLink = null;
            dragDelta = 0;
            resumeAutoplay();
            return;
          }

          var threshold = Math.max(45, getStep() * 0.16);

          if (dragDelta < -threshold) {
            next();
          } else if (dragDelta > threshold) {
            prev();
          } else {
            dragDelta = 0;
            setTransform(true);
          }

          suppressClickOnce = hasDragged;
          pressedLink = null;
          dragDelta = 0;
          resumeAutoplay();
        }

        function onKeydown(event) {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            prev();
            startAutoplay();
          } else if (event.key === 'ArrowRight') {
            event.preventDefault();
            next();
            startAutoplay();
          }
        }

        buildInfiniteSlides();
        root.setAttribute('tabindex', '0');
        syncToggleButton();

        if (controls) {
          controls.addEventListener('pointerdown', function (event) {
            event.stopPropagation();
          });
        }

        root.addEventListener('click', function (event) {
          var clickTarget = null;
          if (event.target instanceof Element) {
            clickTarget = event.target;
          } else if (event.target && event.target.parentElement) {
            clickTarget = event.target.parentElement;
          }

          var clickLink = clickTarget ? clickTarget.closest('a[href]') : null;
          if (clickLink && downLink && clickLink === downLink) {
            var heldMs = Date.now() - pointerDownAt;
            downLink = null;
            if (heldMs >= longPressMs) {
              event.preventDefault();
              event.stopPropagation();
              return;
            }
          } else {
            downLink = null;
          }

          if (!suppressClickOnce) return;
          suppressClickOnce = false;
          event.preventDefault();
          event.stopPropagation();
        }, true);

        prevButton.addEventListener('click', function () {
          prev();
          startAutoplay();
        });

        nextButton.addEventListener('click', function () {
          next();
          startAutoplay();
        });

        if (toggleButton) {
          toggleButton.addEventListener('click', function () {
            toggleAutoplay();
          });
        }

        dots.forEach(function (dot, dotIndex) {
          dot.addEventListener('click', function () {
            index = cloneCount + dotIndex;
            dragDelta = 0;
            setTransform(true);
            startAutoplay();
          });
        });

        track.addEventListener('transitionend', normalizeAfterTransition);

        root.addEventListener('pointerdown', onPointerDown);
        root.addEventListener('pointermove', onPointerMove);
        root.addEventListener('pointerup', onPointerUp);
        root.addEventListener('pointercancel', onPointerUp);
        root.addEventListener('keydown', onKeydown);
        root.addEventListener('pointerleave', function (event) {
          if (isDragging) onPointerUp(event);
        });

        window.addEventListener('resize', function () {
          dragDelta = 0;
          setTransform(false);
        });

        document.addEventListener('visibilitychange', function () {
          if (document.hidden) {
            stopAutoplay();
          } else {
            startAutoplay();
          }
        });

        setTransform(false);
        startAutoplay();
      }

      function initCarousels() {
        var carousels = document.querySelectorAll('[data-pe-carousel]');
        carousels.forEach(setupCarousel);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCarousels);
      } else {
        initCarousels();
      }

      document.addEventListener('astro:page-load', initCarousels);
    }());
  </script>

  <section class="py-20 bg-pe-black text-center relative overflow-hidden" aria-label="Brand statement">
    <div class="absolute inset-0 opacity-10" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full border border-pe-gold/40"></div>
    </div>

    <div class="pe-container relative z-10">
      <p class="pe-script text-pe-rose-display" style="font-size: clamp(2rem, 6vw, 4rem); line-height: 1.2; margin-bottom: 1.25rem;">
        {locale === 'es' ? 'Lujo con Proposito' : 'Luxury with Purpose'}
      </p>

      <p class="font-display text-pe-on-dark-muted font-light text-lg md:text-xl max-w-xl mx-auto leading-relaxed">
        {locale === 'es'
          ? 'Cada pieza tiene una historia. La nuestra es de calidad, cuidado y moda consciente.'
          : 'Every piece has a story. Ours is about quality, care, and mindful fashion.'}
      </p>

      <div class="rose-rule mt-10 max-w-xs mx-auto" aria-hidden="true"></div>
    </div>
  </section>
</BaseLayout>
