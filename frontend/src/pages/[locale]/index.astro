---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProductCard from '../../components/ProductCard.astro';
import Button from '../../components/Button.astro';
import { SUPPORTED_LOCALES, type Locale, t } from '../../i18n/index';
import { getFeaturedProducts, getCategoryTree, FIXTURE_PRODUCTS } from '../../lib/api';

const { locale } = Astro.params as { locale: Locale };

if (!SUPPORTED_LOCALES.includes(locale)) {
  return Astro.redirect('/es/');
}

let featured = [...FIXTURE_PRODUCTS];
try {
  featured = await getFeaturedProducts();
} catch {
  // fixture fallback already set
}

const token = Astro.cookies.get('pe_token')?.value;
const categoryTree = await getCategoryTree();

function collectFeatured(nodes: typeof categoryTree): typeof categoryTree {
  const result: typeof categoryTree = [];

  for (const node of nodes) {
    if (node.featured && node.active) {
      result.push(node);
    } else if (node.children?.length) {
      result.push(...collectFeatured(node.children));
    }
  }

  return result;
}

const categoryTiles = collectFeatured(categoryTree);
---

<BaseLayout title={t('nav.home', locale)} locale={locale}>
  <Hero locale={locale} />

  <section class="py-16 bg-pe-cream" aria-labelledby="featured-heading">
    <div class="pe-container">
      <div class="text-center mb-12">
        <span class="chapter-mark text-base">
          {locale === 'es' ? 'Novedades' : 'New arrivals'}
        </span>

        <h2
          id="featured-heading"
          class="font-display text-pe-black text-3xl md:text-4xl font-light mt-3"
        >
          {locale === 'es' ? 'Recién Llegados' : 'Recently Added'}
        </h2>
      </div>

      {featured.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5 fx-stagger">
          {featured.map((product) => (
            <ProductCard product={product} locale={locale} priority={true} token={token} />
          ))}
        </div>
      ) : (
        <p class="text-center text-pe-charcoal/50 font-sans text-sm">
          {locale === 'es' ? 'No hay productos disponibles.' : 'No products available.'}
        </p>
      )}

      <div class="text-center mt-12">
        <Button href={`/${locale}/products`} variant="outline" trailingIcon="arrow-right">
          {locale === 'es' ? 'Ver toda la colección' : 'View full collection'}
        </Button>
      </div>
    </div>
  </section>

  <section class="py-16 bg-pe-offwhite" aria-labelledby="categories-heading">
    <div class="pe-container">
      <div class="text-center mb-10">
        <span class="chapter-mark text-base">
          {locale === 'es' ? 'Explorar' : 'Explore'}
        </span>

        <h2
          id="categories-heading"
          class="font-display text-pe-black text-3xl md:text-4xl font-light mt-3"
        >
          {locale === 'es' ? 'Por Categoría' : 'By Category'}
        </h2>
      </div>

      {categoryTiles.length === 0 ? (
        <p class="text-center text-pe-charcoal/40 font-sans text-sm py-8">
          {locale === 'es' ? 'Próximamente.' : 'Coming soon.'}
        </p>
      ) : (
        <div data-pe-carousel class="pe-carousel relative overflow-hidden">
          <div
            class="pointer-events-none absolute inset-y-0 left-0 w-10 z-[2]"
            style="background: linear-gradient(to right, var(--pe-surface), transparent)"
          ></div>

          <div
            class="pointer-events-none absolute inset-y-0 right-0 w-10 z-[2]"
            style="background: linear-gradient(to left, var(--pe-surface), transparent)"
          ></div>

          <div class="overflow-hidden px-1 pb-3">
            <div data-pe-carousel-track class="pe-carousel-track">
              {categoryTiles.map((cat, i) => {
                const name = locale === 'es' ? cat.nameEs : (cat.nameEn || cat.nameEs);
                const subs = (cat.children ?? []).filter(s => s.active).slice(0, 4);

                return (
                  <article class="pe-carousel-slide group relative overflow-hidden aspect-[4/5] fx-lift">
                    <a
                      href={`/${locale}/categories/${cat.slug}`}
                      class="absolute inset-0 block z-0"
                      aria-label={name}
                    >
                      {cat.imageUrl ? (
                        <img
                          src={cat.imageUrl}
                          alt={name}
                          loading={i === 0 ? 'eager' : 'lazy'}
                          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                          width="600"
                          height="750"
                          draggable="false"
                        />
                      ) : (
                        <div class="w-full h-full bg-pe-cream"></div>
                      )}

                      <div class="absolute inset-0 bg-gradient-to-t from-pe-black/75 via-pe-black/20 to-transparent"></div>
                      <div class="absolute bottom-0 left-0 right-0 h-[2px] bg-pe-rose scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
                    </a>

                    <div class="absolute bottom-0 left-0 right-0 p-5 z-10 pointer-events-none">
                      <p class="font-display text-pe-offwhite text-xl md:text-2xl font-light leading-tight">
                        {name}
                      </p>

                      {subs.length > 0 && (
                        <div class="flex flex-wrap gap-1.5 mt-2 pointer-events-auto">
                          {subs.map(sub => (
                            <a
                              href={`/${locale}/categories/${sub.slug}`}
                              class="font-sans text-[0.58rem] tracking-[0.2em] uppercase text-pe-offwhite/60 border border-pe-offwhite/22 px-2 py-0.5 hover:text-pe-offwhite hover:border-pe-offwhite/50 transition-colors"
                            >
                              {locale === 'es' ? sub.nameEs : (sub.nameEn || sub.nameEs)}
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </div>

          <div class="mt-6 flex items-center justify-between gap-4">
            <div data-pe-carousel-dots class="flex items-center gap-2">
              {categoryTiles.map((_, i) => (
                <button
                  type="button"
                  data-pe-carousel-dot={i}
                  class={`h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'w-6' : 'w-3'}`}
                  style={i === 0 ? 'background-color: var(--pe-ink)' : 'background-color: color-mix(in srgb, var(--pe-ink) 28%, transparent)'}
                  aria-label={locale === 'es' ? `Ir a categoría ${i + 1}` : `Go to category ${i + 1}`}
                ></button>
              ))}
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                data-pe-carousel-prev
                class="h-10 w-10 inline-flex items-center justify-center rounded-full border border-pe-charcoal/20 text-pe-charcoal hover:border-pe-charcoal/40 hover:bg-pe-cream transition-colors"
                aria-label={locale === 'es' ? 'Categoría anterior' : 'Previous category'}
              >
                <span aria-hidden="true">←</span>
              </button>

              <button
                type="button"
                data-pe-carousel-next
                class="h-10 w-10 inline-flex items-center justify-center rounded-full border border-pe-charcoal/20 text-pe-charcoal hover:border-pe-charcoal/40 hover:bg-pe-cream transition-colors"
                aria-label={locale === 'es' ? 'Siguiente categoría' : 'Next category'}
              >
                <span aria-hidden="true">→</span>
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <style>
    .pe-carousel {
      --pe-carousel-gap: 1rem;
      cursor: grab;
      user-select: none;
      touch-action: pan-y;
    }

    .pe-carousel.is-dragging {
      cursor: grabbing;
    }

    .pe-carousel-track {
      display: flex;
      gap: var(--pe-carousel-gap);
      transform: translate3d(0, 0, 0);
      transition: transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }

    .pe-carousel-track.is-resetting,
    .pe-carousel-track.is-dragging {
      transition: none;
    }

    .pe-carousel-slide {
      flex: 0 0 82%;
    }

    .pe-carousel-slide.is-clone {
      pointer-events: none;
    }

    @media (min-width: 640px) {
      .pe-carousel-slide {
        flex-basis: calc((100% - var(--pe-carousel-gap)) / 2);
      }
    }

    @media (min-width: 1024px) {
      .pe-carousel-slide {
        flex-basis: calc((100% - (var(--pe-carousel-gap) * 2)) / 3);
      }
    }
  </style>

  <script is:inline>
    (function () {
      function setupCarousel(root) {
        if (root.dataset.peCarouselReady === 'true') return;
        root.dataset.peCarouselReady = 'true';

        var track = root.querySelector('[data-pe-carousel-track]');
        var prevButton = root.querySelector('[data-pe-carousel-prev]');
        var nextButton = root.querySelector('[data-pe-carousel-next]');
        var dots = Array.prototype.slice.call(root.querySelectorAll('[data-pe-carousel-dot]'));

        if (!track || !prevButton || !nextButton) return;

        var originalSlides = Array.prototype.slice.call(track.children);
        var originalCount = originalSlides.length;

        if (originalCount <= 1) {
          prevButton.style.display = 'none';
          nextButton.style.display = 'none';
          return;
        }

        var cloneCount = Math.min(3, originalCount);
        var index = cloneCount;
        var timer = null;
        var autoplayMs = 4000;
        var startX = 0;
        var currentX = 0;
        var dragDelta = 0;
        var isDragging = false;
        var hasDragged = false;
        var pressedLink = null;

        function buildInfiniteSlides() {
          var firstClones = originalSlides.slice(0, cloneCount).map(function (slide) {
            var clone = slide.cloneNode(true);
            clone.classList.add('is-clone');
            clone.setAttribute('aria-hidden', 'true');
            return clone;
          });

          var lastClones = originalSlides.slice(-cloneCount).map(function (slide) {
            var clone = slide.cloneNode(true);
            clone.classList.add('is-clone');
            clone.setAttribute('aria-hidden', 'true');
            return clone;
          });

          lastClones.forEach(function (clone) {
            track.insertBefore(clone, track.firstChild);
          });

          firstClones.forEach(function (clone) {
            track.appendChild(clone);
          });
        }

        function getGap() {
          var styles = window.getComputedStyle(track);
          return parseFloat(styles.columnGap || styles.gap || '0') || 0;
        }

        function getStep() {
          var slide = track.children[0];
          if (!slide) return 0;

          return slide.getBoundingClientRect().width + getGap();
        }

        function getRealIndex() {
          return (index - cloneCount + originalCount) % originalCount;
        }

        function setTransform(withTransition) {
          var step = getStep();
          var offset = index * step - dragDelta;

          track.classList.toggle('is-resetting', !withTransition);
          track.style.transform = 'translate3d(-' + offset + 'px, 0, 0)';

          if (!withTransition) {
            requestAnimationFrame(function () {
              track.classList.remove('is-resetting');
            });
          }

          updateDots();
        }

        function updateDots() {
          var activeIndex = getRealIndex();

          dots.forEach(function (dot, dotIndex) {
            var active = dotIndex === activeIndex;

            dot.classList.toggle('w-6', active);
            dot.classList.toggle('w-3', !active);

            dot.style.backgroundColor = active
              ? 'var(--pe-ink)'
              : 'color-mix(in srgb, var(--pe-ink) 28%, transparent)';
          });
        }

        function goTo(newIndex) {
          dragDelta = 0;
          index = newIndex;
          setTransform(true);
        }

        function next() {
          goTo(index + 1);
        }

        function prev() {
          goTo(index - 1);
        }

        function normalizeAfterTransition() {
          if (index >= cloneCount + originalCount) {
            index = cloneCount;
            setTransform(false);
          }

          if (index < cloneCount) {
            index = cloneCount + originalCount - 1;
            setTransform(false);
          }
        }

        function stopAutoplay() {
          if (timer !== null) {
            window.clearInterval(timer);
            timer = null;
          }
        }

        function startAutoplay() {
          stopAutoplay();

          if (document.hidden) return;

          timer = window.setInterval(function () {
            next();
          }, autoplayMs);
        }

        function pauseAutoplay() {
          stopAutoplay();
        }

        function resumeAutoplay() {
          startAutoplay();
        }

        function onPointerDown(event) {
          if (event.pointerType === 'mouse' && event.button !== 0) return;

          isDragging = true;
          hasDragged = false;
          pressedLink = event.target.closest('a[href]');
          startX = event.clientX;
          currentX = startX;
          dragDelta = 0;

          root.classList.add('is-dragging');
          track.classList.add('is-dragging');
          pauseAutoplay();

          if (root.setPointerCapture) {
            root.setPointerCapture(event.pointerId);
          }
        }

        function onPointerMove(event) {
          if (!isDragging) return;

          currentX = event.clientX;
          dragDelta = currentX - startX;

          if (Math.abs(dragDelta) > 8) {
            hasDragged = true;
          }

          setTransform(false);
        }

        function onPointerUp(event) {
          if (!isDragging) return;

          isDragging = false;
          root.classList.remove('is-dragging');
          track.classList.remove('is-dragging');

          if (root.releasePointerCapture) {
            try {
              root.releasePointerCapture(event.pointerId);
            } catch {}
          }

          if (!hasDragged && pressedLink) {
            var href = pressedLink.getAttribute('href');

            pressedLink = null;
            dragDelta = 0;
            resumeAutoplay();

            if (href) {
              window.location.href = href;
            }

            return;
          }

          var threshold = Math.max(45, getStep() * 0.16);

          if (dragDelta < -threshold) {
            next();
          } else if (dragDelta > threshold) {
            prev();
          } else {
            dragDelta = 0;
            setTransform(true);
          }

          pressedLink = null;
          dragDelta = 0;
          resumeAutoplay();
        }

        buildInfiniteSlides();

        prevButton.addEventListener('click', function () {
          prev();
          startAutoplay();
        });

        nextButton.addEventListener('click', function () {
          next();
          startAutoplay();
        });

        dots.forEach(function (dot, dotIndex) {
          dot.addEventListener('click', function () {
            index = cloneCount + dotIndex;
            dragDelta = 0;
            setTransform(true);
            startAutoplay();
          });
        });

        track.addEventListener('transitionend', normalizeAfterTransition);

        root.addEventListener('mouseenter', pauseAutoplay);
        root.addEventListener('mouseleave', resumeAutoplay);
        root.addEventListener('focusin', pauseAutoplay);
        root.addEventListener('focusout', resumeAutoplay);

        root.addEventListener('pointerdown', onPointerDown);
        root.addEventListener('pointermove', onPointerMove);
        root.addEventListener('pointerup', onPointerUp);
        root.addEventListener('pointercancel', onPointerUp);
        root.addEventListener('pointerleave', function (event) {
          if (isDragging) onPointerUp(event);
        });

        window.addEventListener('resize', function () {
          dragDelta = 0;
          setTransform(false);
        });

        document.addEventListener('visibilitychange', function () {
          if (document.hidden) {
            stopAutoplay();
          } else {
            startAutoplay();
          }
        });

        setTransform(false);
        startAutoplay();
      }

      function initCarousels() {
        var carousels = document.querySelectorAll('[data-pe-carousel]');
        carousels.forEach(setupCarousel);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCarousels);
      } else {
        initCarousels();
      }

      document.addEventListener('astro:page-load', initCarousels);
    }());
  </script>

  <section class="py-20 bg-pe-black text-center relative overflow-hidden" aria-label="Brand statement">
    <div class="absolute inset-0 opacity-10" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full border border-pe-gold/40"></div>
    </div>

    <div class="pe-container relative z-10">
      <p class="pe-script text-pe-rose" style="font-size: clamp(2rem, 6vw, 4rem); line-height: 1.2; margin-bottom: 1.25rem;">
        {locale === 'es' ? 'Lujo con Propósito' : 'Luxury with Purpose'}
      </p>

      <p class="font-display text-pe-offwhite/70 font-light text-lg md:text-xl max-w-xl mx-auto leading-relaxed">
        {locale === 'es'
          ? 'Cada pieza tiene una historia. La nuestra es de calidad, cuidado y moda consciente.'
          : 'Every piece has a story. Ours is about quality, care, and mindful fashion.'}
      </p>

      <div class="rose-rule mt-10 max-w-xs mx-auto" aria-hidden="true"></div>
    </div>
  </section>
</BaseLayout>