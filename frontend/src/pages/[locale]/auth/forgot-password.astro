---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ForgotPasswordForm from '../../../islands/auth/ForgotPasswordForm';
import { type Locale, SUPPORTED_LOCALES } from '../../../i18n/index';

const { locale } = Astro.params as { locale: Locale };
if (!SUPPORTED_LOCALES.includes(locale)) return Astro.redirect('/es/auth/forgot-password');
---

<BaseLayout title={locale === 'es' ? 'Restablecer contraseña' : 'Reset password'} locale={locale}>
  <div class="min-h-[calc(100vh-180px)] grid grid-cols-1 lg:grid-cols-5">

    <!-- Left: editorial brand panel -->
    <div class="hidden lg:block lg:col-span-3 relative overflow-hidden">
      <img
        src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1200&q=80"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-pe-black/75 via-pe-black/40 to-transparent"></div>
      <div class="absolute inset-0 flex flex-col justify-end p-12 pb-16">
        <div class="rose-rule-short mb-6" aria-hidden="true"></div>
        <p class="pe-script text-pe-rose-display-display leading-tight" style="font-size: clamp(2rem, 4vw, 3.2rem);">
          {locale === 'es' ? 'Lujo con Propósito' : 'Luxury with Purpose'}
        </p>
        <p class="font-display text-pe-offwhite/60 font-light text-lg mt-3 max-w-md">
          {locale === 'es'
            ? 'Descubrí piezas únicas de las marcas más deseadas del mundo.'
            : 'Discover unique pieces from the world\'s most coveted brands.'}
        </p>
      </div>
    </div>

    <!-- Right: form panel -->
    <div class="lg:col-span-2 bg-pe-cream flex items-center justify-center px-8 py-16">
      <div class="w-full max-w-sm">

        <a href={`/${locale}/`} class="flex flex-col items-center mb-10">
          <img src="/logo-pe.svg" alt="Pilar Estilo" width="52" height="52" class="mb-2" />
          <p class="pe-script text-pe-rose-display text-xl">{locale === 'es' ? 'Lujo con Propósito' : 'Luxury with Purpose'}</p>
        </a>

        <h1 class="font-display text-pe-black text-3xl font-light text-center mb-8">
          {locale === 'es' ? 'Restablecer contraseña' : 'Reset password'}
        </h1>

        <ForgotPasswordForm client:load locale={locale} />
      </div>
    </div>

  </div>
</BaseLayout>
