---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ReviewModerationQueue from '../../islands/admin/ReviewModerationQueue';
---

<AdminLayout
  title="Resenas"
  breadcrumbs={[{ label: 'Resenas' }]}
>
  <div class="mb-5 sm:mb-6">
    <h1 class="font-display text-pe-black text-2xl sm:text-3xl font-light">Resenas</h1>
    <p class="font-sans text-[0.78rem] sm:text-sm text-pe-muted mt-1">
      Modera las resenas enviadas por los clientes.
    </p>
  </div>

  <ReviewModerationQueue client:load />
</AdminLayout>
