---
import AdminLayout from '../../layouts/AdminLayout.astro';
import CategoryTree from '../../islands/admin/CategoryTree';
---

<AdminLayout
  title="Categorias"
  breadcrumbs={[{ label: 'Categorias' }]}
>
  <div class="mb-5 sm:mb-6">
    <h1 class="font-display text-pe-black text-2xl sm:text-3xl font-light">Categorias</h1>
    <p class="font-sans text-[0.78rem] sm:text-sm text-pe-charcoal/45 mt-1">
      Gestiona el arbol de categorias del catalogo.
    </p>
  </div>

  <CategoryTree client:load />
</AdminLayout>
