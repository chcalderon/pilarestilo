---
import AdminLayout from '../../layouts/AdminLayout.astro';
import PaymentReviewQueue from '../../islands/admin/PaymentReviewQueue';
---

<AdminLayout
  title="Pagos"
  breadcrumbs={[{ label: 'Pagos' }]}
>
  <div class="mb-5 sm:mb-6">
    <h1 class="font-display text-pe-black text-2xl sm:text-3xl font-light">Revision de Pagos</h1>
    <p class="font-sans text-[0.78rem] sm:text-sm text-pe-charcoal/45 mt-1">
      Revisa pagos por aprobar y consulta el historial de pagos aprobados.
    </p>
  </div>

  <PaymentReviewQueue client:load />
</AdminLayout>
