---
import AdminLayout from '../../layouts/AdminLayout.astro';
import DiscountCodeManager from '../../islands/admin/DiscountCodeManager';
import WelcomeDiscountPanel from '../../islands/admin/WelcomeDiscountPanel';
---

<AdminLayout
  title="Códigos de descuento"
  breadcrumbs={[{ label: 'Códigos de descuento' }]}
>
  <div class="mb-5 sm:mb-6">
    <h1 class="font-display text-pe-black text-2xl sm:text-3xl font-light">Códigos de descuento</h1>
    <p class="font-sans text-[0.78rem] sm:text-sm text-pe-muted mt-1">
      Crea y gestiona códigos de descuento para tus clientes.
    </p>
  </div>

  <WelcomeDiscountPanel client:load />
  <DiscountCodeManager client:load />
</AdminLayout>
