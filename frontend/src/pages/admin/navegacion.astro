---
import AdminLayout from '../../layouts/AdminLayout.astro';
import NavigationSectionsManager from '../../islands/admin/NavigationSectionsManager';
---

<AdminLayout
  title="Navegación"
  breadcrumbs={[{ label: 'Navegación' }]}
>
  <div class="mb-5 sm:mb-6">
    <h1 class="font-display text-pe-black text-2xl sm:text-3xl font-light">Navegación</h1>
    <p class="font-sans text-[0.78rem] sm:text-sm text-pe-charcoal/45 mt-1">
      Configura las secciones del mega menú editorial.
    </p>
  </div>

  <NavigationSectionsManager client:load />
</AdminLayout>
