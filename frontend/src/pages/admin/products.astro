---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ProductTable from '../../islands/admin/ProductTable';
---

<AdminLayout
  title="Productos"
  breadcrumbs={[{ label: 'Productos' }]}
>
  <div class="mb-5 sm:mb-6">
    <h1 class="font-display text-pe-black text-2xl sm:text-3xl font-light">Productos</h1>
    <p class="font-sans text-[0.78rem] sm:text-sm text-pe-muted mt-1">
      Gestiona el catalogo de productos de Pilar Estilo.
    </p>
  </div>

  <ProductTable client:load />
</AdminLayout>
