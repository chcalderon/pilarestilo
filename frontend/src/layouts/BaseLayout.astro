---
import ThemeBootstrap from '../components/ThemeBootstrap.astro';
import { SUPPORTED_LOCALES, type Locale } from '../i18n/index';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StoreWhatsAppButton from '../components/StoreWhatsAppButton.astro';
import SearchOverlay from '../islands/search/SearchOverlay';
import { getPublicStoreSettings } from '../lib/api';
import { resolveSiteUrl, absoluteUrl, canonicalUrlFor } from '../lib/siteUrl';
import '../styles/globals.css';

export interface Props {
  title: string;
  description?: string;
  locale: Locale;
  hideChrome?: boolean;
  /** Only the home hero gets the full logo entrance; every other page starts already compact. */
  isHome?: boolean;
  /** Absolute or site-relative image for social cards. Defaults to the store logo. */
  ogImage?: string;
  /** `website` for most pages, `product` on a product detail page. */
  ogType?: 'website' | 'product' | 'article';
  /** Keep the page out of the index (checkout, account, auth, wishlist…). */
  noindex?: boolean;
}

const {
  title,
  description = 'Pilar Estilo — Lujo con Propósito. Moda de lujo curada, nueva y de segunda mano.',
  locale,
  hideChrome = false,
  isHome = false,
  ogImage = '/logo-full.png',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const storeSettings = await getPublicStoreSettings();

const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY as string | undefined;

const reqHeaders = Astro.request.headers;
const siteUrl = resolveSiteUrl(Astro.url, reqHeaders);
const canonicalUrl = canonicalUrlFor(Astro.url, reqHeaders);
const cleanPath = canonicalUrl.slice(siteUrl.length) || '/';
const ogImageUrl = absoluteUrl(ogImage, Astro.url, reqHeaders);
const fullTitle = `${title} | Pilar Estilo`;

// hreflang alternates: only for /{locale}/… paths, swapping the leading segment.
const [, firstSegment, ...restSegments] = cleanPath.split('/');
const hasLocalePrefix = (SUPPORTED_LOCALES as readonly string[]).includes(firstSegment);
const alternates = hasLocalePrefix
  ? SUPPORTED_LOCALES.map((loc) => ({
      hreflang: loc,
      href: `${siteUrl}/${[loc, ...restSegments].join('/')}`,
    }))
  : [];
const localeToOg: Record<Locale, string> = { es: 'es_CL', en: 'en_US' };
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <ThemeBootstrap />
    {posthogKey && (
      <script is:inline define:vars={{ posthogKey }}>
        /* eslint-disable no-var, prefer-rest-params, @typescript-eslint/no-unused-expressions -- vendored PostHog loader snippet, kept verbatim from posthog.com/docs */
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageViewId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        /* eslint-enable no-var, prefer-rest-params, @typescript-eslint/no-unused-expressions */
        window.posthog.init(posthogKey, {
          api_host: "/phog",
          ui_host: "https://us.posthog.com",
          persistence: "sessionStorage",
          person_profiles: "identified_only",
          respect_dnt: true,
          autocapture: true,
          capture_pageview: true,
          capture_pageleave: true,
          disable_session_recording: true,
          loaded: function (ph) {
            try {
              if (window.localStorage.getItem("pe-analytics-opt-out") === "1") ph.opt_out_capturing();
            } catch {
              /* localStorage blocked (private mode) — analytics stays on */
            }
          },
        });
      </script>
    )}
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F8F4EF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A1614" media="(prefers-color-scheme: dark)" />

    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    )}

    <meta property="og:site_name" content="Pilar Estilo" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={localeToOg[locale]} />
    <meta property="og:locale:alternate" content={localeToOg[otherLocale]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col antialiased relative">
    <div class="pe-grain-site" aria-hidden="true"></div>
    {!hideChrome && <Navbar locale={locale} isHome={isHome} />}
    <main class="flex-1 relative z-[2]">
      <slot />
    </main>
    {!hideChrome && (
      <Footer
        locale={locale}
        instagramUrl={storeSettings?.instagramUrl}
        facebookUrl={storeSettings?.facebookUrl}
      />
    )}
    {!hideChrome && <StoreWhatsAppButton locale={locale} phone={storeSettings?.whatsappNumber} />}
    <SearchOverlay client:only="react" locale={locale} />
  </body>
</html>
